{
  "schema_version": 1,
  "day": 9,
  "scenes": [
    {
      "id": "STORY_D09_MANAGEMENT",
      "day": 9,
      "title": "DAY 9 · 관리 대화",
      "trigger": "management_entered",
      "delivery": "blocking",
      "repeat_policy": "once_first_cycle_day",
      "metadata": {
        "title": "관리 대화"
      },
      "cues": [
        {
          "id": "STORY_D09_MANAGEMENT_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "오늘은 단순 탐험가가 아닙니다. 왕국 조사관 아이리스가 직접 옵니다.",
          "emotion_direction": "엄중",
          "portrait_emotion": "stern",
          "source_line": 619
        },
        {
          "id": "STORY_D09_MANAGEMENT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "조사관? 세금 문제인가?",
          "emotion_direction": "긴장",
          "portrait_emotion": "flustered",
          "source_line": 620
        },
        {
          "id": "STORY_D09_MANAGEMENT_003",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "그 경우에는 제가 먼저 도망가겠습니다.",
          "emotion_direction": "즉답",
          "portrait_emotion": "accounting",
          "source_line": 621
        },
        {
          "id": "STORY_D09_MANAGEMENT_004",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "아이리스는 성의 입구, 병영, 보물 보관실, 왕좌까지 동선을 기록할 겁니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 622
        },
        {
          "id": "STORY_D09_MANAGEMENT_005",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "지도를 빼앗으면 안 됩니까?",
          "emotion_direction": "걱정",
          "portrait_emotion": "mischief",
          "source_line": 623
        },
        {
          "id": "STORY_D09_MANAGEMENT_006",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "저런 유형은 지도보다 머릿속 기록이 더 정확합니다.",
          "emotion_direction": "담담",
          "portrait_emotion": "dry",
          "source_line": 624
        },
        {
          "id": "STORY_D09_MANAGEMENT_007",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "그럼 머리를 때리면 기록도 날아가?",
          "emotion_direction": "자신감",
          "portrait_emotion": "eager",
          "source_line": 625
        },
        {
          "id": "STORY_D09_MANAGEMENT_008",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "오늘도 문제 해결이 너무 직접적이구나.",
          "emotion_direction": "말림",
          "portrait_emotion": "serious",
          "source_line": 626
        },
        {
          "id": "STORY_D09_MANAGEMENT_009",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "분석은 끝나지 않았는데 방어선이 예상보다 빨리 움직였군요.",
          "emotion_direction": "놀람",
          "portrait_emotion": "inquisitive",
          "source_line": 665
        },
        {
          "id": "STORY_D09_MANAGEMENT_010",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "관찰하는 자도 관찰당한다는 걸 기억하십시오.",
          "emotion_direction": "차분",
          "portrait_emotion": "stern",
          "source_line": 666
        }
      ]
    },
    {
      "id": "STORY_D09_PRECOMBAT",
      "day": 9,
      "title": "DAY 9 · 전투 직전",
      "trigger": "precombat_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "전투 직전"
      },
      "cues": [
        {
          "id": "STORY_D09_PRECOMBAT_001",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "입구 폭, 복도 길이, 경비 교대. 예상보다 의도가 분명한 구조군요.",
          "emotion_direction": "차분",
          "portrait_emotion": "inquisitive",
          "source_line": 630
        },
        {
          "id": "STORY_D09_PRECOMBAT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "당연하다. 모든 돌 하나가 내 천재적인 설계 아래 놓였다.",
          "emotion_direction": "허세",
          "portrait_emotion": "proud",
          "source_line": 631
        },
        {
          "id": "STORY_D09_PRECOMBAT_003",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "절반은 원래 있던 동굴이고 절반은 공사 실수입니다.",
          "emotion_direction": "작게",
          "portrait_emotion": "stern",
          "source_line": 632
        },
        {
          "id": "STORY_D09_PRECOMBAT_004",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "‘마왕, 사실과 연출을 자주 혼동함.’",
          "emotion_direction": "메모",
          "portrait_emotion": "inquisitive",
          "source_line": 633
        },
        {
          "id": "STORY_D09_PRECOMBAT_005",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "그런 것까지 적지 마라!",
          "emotion_direction": "당황",
          "portrait_emotion": "flustered",
          "source_line": 634
        },
        {
          "id": "STORY_D09_PRECOMBAT_006",
          "speaker_id": "CHR_EXPLORER_MILO",
          "speaker_label": "밀로",
          "text_ko": "조사관님, 저 방은 세 번 가 봤는데 갈 때마다 다른 데로 나와요.",
          "emotion_direction": "조심스러움",
          "portrait_emotion": "curious",
          "source_line": 635
        },
        {
          "id": "STORY_D09_PRECOMBAT_007",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "길이 바뀐 게 아니라 당신이 매번 틀린 겁니다.",
          "emotion_direction": "냉정",
          "portrait_emotion": "stern",
          "source_line": 636
        },
        {
          "id": "STORY_D09_PRECOMBAT_008",
          "speaker_id": "CHR_EXPLORER_MILO",
          "speaker_label": "밀로",
          "text_ko": "아. 그러면 보고서 세 장도 전부 다시 써야겠네요.",
          "emotion_direction": "깨달음",
          "portrait_emotion": "curious",
          "source_line": 637
        }
      ]
    },
    {
      "id": "STORY_D09_COMBAT_01",
      "day": 9,
      "title": "DAY 9 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 0
      },
      "cues": [
        {
          "id": "STORY_D09_COMBAT_01_001",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "전열은 푸딩이 고정하고, 후열의 핀이 화력을 보충합니다. 곱은 빈틈을 메우는군요.",
          "emotion_direction": "분석",
          "portrait_emotion": "inquisitive",
          "source_line": 641
        },
        {
          "id": "STORY_D09_COMBAT_01_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "전투 중에 우리 부하를 멋대로 평가하지 마라.",
          "emotion_direction": "경계",
          "portrait_emotion": "serious",
          "source_line": 642
        },
        {
          "id": "STORY_D09_COMBAT_01_003",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "멋대로가 아니라 관찰한 대로입니다. 세 사람의 호흡은 예상보다 좋습니다.",
          "emotion_direction": "담담",
          "portrait_emotion": "inquisitive",
          "source_line": 643
        },
        {
          "id": "STORY_D09_COMBAT_01_004",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "칭찬받았다!",
          "emotion_direction": "기쁨",
          "portrait_emotion": "happy",
          "source_line": 644
        }
      ]
    },
    {
      "id": "STORY_D09_COMBAT_02",
      "day": 9,
      "title": "DAY 9 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 10
      },
      "cues": [
        {
          "id": "STORY_D09_COMBAT_02_001",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "적한테 칭찬받고 힘내지 마. 그래도 기록은 정확하네.",
          "emotion_direction": "단호",
          "portrait_emotion": "proud",
          "source_line": 645
        },
        {
          "id": "STORY_D09_COMBAT_02_002",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "곱 기록도 해! ‘엄청 세고 더 엄청 셈’이라고!",
          "emotion_direction": "의욕",
          "portrait_emotion": "eager",
          "source_line": 646
        },
        {
          "id": "STORY_D09_COMBAT_02_003",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "‘자기평가가 과도함.’ 그렇게 적겠습니다.",
          "emotion_direction": "미세한 웃음",
          "portrait_emotion": "inquisitive",
          "source_line": 647
        },
        {
          "id": "STORY_D09_COMBAT_02_004",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "조사관 뒤로 도둑 둘이 움직입니다. 기록에 신경 쓰다 금고를 놓치지 마십시오.",
          "emotion_direction": "집중",
          "portrait_emotion": "stern",
          "source_line": 648
        }
      ]
    },
    {
      "id": "STORY_D09_RESULT_WIN",
      "day": 9,
      "title": "DAY 9 · 승리 결산",
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "승리 결산"
      },
      "cues": [
        {
          "id": "STORY_D09_RESULT_WIN_001",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "단순한 우연으로 버틴 성은 아니군요. 보고서의 위험 등급을 올리겠습니다.",
          "emotion_direction": "인정",
          "portrait_emotion": "inquisitive",
          "source_line": 652
        },
        {
          "id": "STORY_D09_RESULT_WIN_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "드디어 왕국 공문서가 내 위엄을 인정하는군.",
          "emotion_direction": "우쭐",
          "portrait_emotion": "serious",
          "source_line": 653
        },
        {
          "id": "STORY_D09_RESULT_WIN_003",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "위험 등급 상승은 축하장이 아니라 병력이 늘어난다는 뜻입니다.",
          "emotion_direction": "건조",
          "portrait_emotion": "dry",
          "source_line": 654
        },
        {
          "id": "STORY_D09_RESULT_WIN_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "위엄에는 늘 청구서가 붙는군.",
          "emotion_direction": "작게",
          "portrait_emotion": "serious",
          "source_line": 655
        },
        {
          "id": "STORY_D09_RESULT_WIN_005",
          "speaker_id": "CHR_EXPLORER_MILO",
          "speaker_label": "밀로",
          "text_ko": "제 예전 보고서 제목도 ‘수상한 구멍’에서 ‘상당히 수상한 성’으로 고치겠습니다.",
          "emotion_direction": "미안함",
          "portrait_emotion": "panic",
          "source_line": 656
        },
        {
          "id": "STORY_D09_RESULT_WIN_006",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "드디어 ‘성’이라고 불렀다. 오늘 가장 큰 성과다.",
          "emotion_direction": "감격",
          "portrait_emotion": "proud",
          "source_line": 657
        },
        {
          "id": "STORY_D09_RESULT_WIN_007",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "내일이면 길드 게시판에 이곳의 이름이 오를 겁니다. 그 뒤에는 우연한 방문객이 아니라 토벌대가 옵니다.",
          "emotion_direction": "떠나며",
          "portrait_emotion": "inquisitive",
          "source_line": 658
        },
        {
          "id": "STORY_D09_RESULT_WIN_008",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "그리고 그 토벌대 마지막에는, 지도를 새로 공부한 레온이 섞여 있을 가능성이 높습니다.",
          "emotion_direction": "예고",
          "portrait_emotion": "stern",
          "source_line": 659
        }
      ]
    }
  ]
}
