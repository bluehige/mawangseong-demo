{
  "schema_version": 1,
  "day": 22,
  "scenes": [
    {
      "id": "STORY_D22_MANAGEMENT",
      "day": 22,
      "title": "DAY 22 · 관리 대화",
      "trigger": "management_entered",
      "delivery": "blocking",
      "repeat_policy": "once_first_cycle_day",
      "metadata": {
        "title": "관리 대화"
      },
      "cues": [
        {
          "id": "STORY_D22_MANAGEMENT_001",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "큰일이에요! 왕국 쪽에서 우리 교대 시간을 적은 종이를 주웠어요.",
          "emotion_direction": "흥분",
          "portrait_emotion": "mischief",
          "source_line": 1698
        },
        {
          "id": "STORY_D22_MANAGEMENT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "어디 보자. ‘푸딩, 아침 순찰 뒤 간식.’ 이것까지 적었어?",
          "emotion_direction": "불쾌",
          "portrait_emotion": "offended",
          "source_line": 1699
        },
        {
          "id": "STORY_D22_MANAGEMENT_003",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "간식 시간은 군사 기밀이었어?",
          "emotion_direction": "충격",
          "portrait_emotion": "happy",
          "source_line": 1700
        },
        {
          "id": "STORY_D22_MANAGEMENT_004",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "식량 소비와 직결되니 재정 기밀이기도 합니다.",
          "emotion_direction": "엄격",
          "portrait_emotion": "accounting",
          "source_line": 1701
        },
        {
          "id": "STORY_D22_MANAGEMENT_005",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "‘곱, 호출 전에 이미 뛰고 있음.’ 이건 틀린 말은 아니네.",
          "emotion_direction": "읽음",
          "portrait_emotion": "eager",
          "source_line": 1702
        },
        {
          "id": "STORY_D22_MANAGEMENT_006",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "‘핀, 말은 적으나 한마디가 아픔.’",
          "emotion_direction": "읽음",
          "portrait_emotion": "proud",
          "source_line": 1703
        },
        {
          "id": "STORY_D22_MANAGEMENT_007",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "그것도 맞네.",
          "emotion_direction": "고개끔뻑",
          "portrait_emotion": "eager",
          "source_line": 1704
        },
        {
          "id": "STORY_D22_MANAGEMENT_008",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "조사관 아이리스는 감시초소의 사각과 병력 교대 시간을 함께 기록하고 있습니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 1705
        },
        {
          "id": "STORY_D22_MANAGEMENT_009",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "같은 시간, 같은 길, 같은 대응. 반복은 가장 친절한 약점입니다.",
          "emotion_direction": "냉정",
          "portrait_emotion": "stern",
          "source_line": 1706
        },
        {
          "id": "STORY_D22_MANAGEMENT_010",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "남의 집 시간표를 훔쳐보는 취미가 친절하진 않은데.",
          "emotion_direction": "도발",
          "portrait_emotion": "serious",
          "source_line": 1707
        },
        {
          "id": "STORY_D22_MANAGEMENT_011",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "침입자는 원래 초대장을 기다리지 않습니다.",
          "emotion_direction": "태연",
          "portrait_emotion": "inquisitive",
          "source_line": 1708
        },
        {
          "id": "STORY_D22_MANAGEMENT_012",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "맞는 말이네. 말투는 재수 없지만.",
          "emotion_direction": "감탄",
          "portrait_emotion": "teasing",
          "source_line": 1709
        },
        {
          "id": "STORY_D22_MANAGEMENT_013",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "조사관은 길을 읽고 공병은 시설을 멈춥니다. 둘을 붙게 두면 도둑이 보물실로 빠질 틈이 생깁니다.",
          "emotion_direction": "지시",
          "portrait_emotion": "stern",
          "source_line": 1710
        },
        {
          "id": "STORY_D22_MANAGEMENT_014",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "앞, 시설, 보물실을 다 봐야 한다는 거네.",
          "emotion_direction": "걱정",
          "portrait_emotion": "happy",
          "source_line": 1711
        },
        {
          "id": "STORY_D22_MANAGEMENT_015",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "그렇다면 오늘부터 교대가 아니라 연결이다. 한쪽이 움직이면 다른 쪽이 자리를 받쳐.",
          "emotion_direction": "결심",
          "portrait_emotion": "serious",
          "source_line": 1712
        }
      ]
    },
    {
      "id": "STORY_D22_PRECOMBAT",
      "day": 22,
      "title": "DAY 22 · 전투 직전",
      "trigger": "precombat_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "전투 직전"
      },
      "cues": [
        {
          "id": "STORY_D22_PRECOMBAT_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "탐험대 뒤로 조사관이 들어오고, 곧 공병이 시설 쪽으로 빠집니다.",
          "emotion_direction": "집중",
          "portrait_emotion": "stern",
          "source_line": 1716
        },
        {
          "id": "STORY_D22_PRECOMBAT_002",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "저도 저쪽 정찰표를 만들어 왔어요.",
          "emotion_direction": "자랑",
          "portrait_emotion": "mischief",
          "source_line": 1717
        },
        {
          "id": "STORY_D22_PRECOMBAT_003",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "제목이 왜 ‘왕국 정보망 완전 장악’이지?",
          "emotion_direction": "의심",
          "portrait_emotion": "serious",
          "source_line": 1718
        },
        {
          "id": "STORY_D22_PRECOMBAT_004",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "‘복도 모퉁이에서 두 장 주움’보다 멋있잖아요.",
          "emotion_direction": "당당",
          "portrait_emotion": "mischief",
          "source_line": 1719
        },
        {
          "id": "STORY_D22_PRECOMBAT_005",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "잉크 사용량은 완전 장악 수준입니다.",
          "emotion_direction": "검토",
          "portrait_emotion": "accounting",
          "source_line": 1720
        },
        {
          "id": "STORY_D22_PRECOMBAT_006",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "조사관 가방만 뺏으면 기록 못 가져가겠지?",
          "emotion_direction": "의욕",
          "portrait_emotion": "eager",
          "source_line": 1721
        },
        {
          "id": "STORY_D22_PRECOMBAT_007",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "가방만 보지 말고 손을 봐. 진짜 중요한 건 안쪽 주머니에 넣거든.",
          "emotion_direction": "선배답게",
          "portrait_emotion": "teasing",
          "source_line": 1722
        },
        {
          "id": "STORY_D22_PRECOMBAT_008",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "역시 도둑 선생님.",
          "emotion_direction": "감탄",
          "portrait_emotion": "eager",
          "source_line": 1723
        },
        {
          "id": "STORY_D22_PRECOMBAT_009",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "수업료는 금고에서 알아서 가져갈게.",
          "emotion_direction": "미소",
          "portrait_emotion": "teasing",
          "source_line": 1724
        },
        {
          "id": "STORY_D22_PRECOMBAT_010",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "수업 취소입니다.",
          "emotion_direction": "정색",
          "portrait_emotion": "accounting",
          "source_line": 1725
        },
        {
          "id": "STORY_D22_PRECOMBAT_011",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "저쪽도 우리를 읽고, 우리도 저쪽을 읽네.",
          "emotion_direction": "관찰",
          "portrait_emotion": "proud",
          "source_line": 1726
        },
        {
          "id": "STORY_D22_PRECOMBAT_012",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "먼저 읽는 쪽보다, 읽힌 뒤에도 바꿀 수 있는 쪽이 이긴다.",
          "emotion_direction": "담담",
          "portrait_emotion": "serious",
          "source_line": 1727
        },
        {
          "id": "STORY_D22_PRECOMBAT_013",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "꽤 마왕다운 답입니다. 이제 실행만 마왕답게 해 주십시오.",
          "emotion_direction": "미묘한만족",
          "portrait_emotion": "stern",
          "source_line": 1728
        }
      ]
    },
    {
      "id": "STORY_D22_COMBAT_01",
      "day": 22,
      "title": "DAY 22 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 0
      },
      "cues": [
        {
          "id": "STORY_D22_COMBAT_01_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "조사관이 곧 들어옵니다. 기록을 완성하기 전에 끊으십시오.",
          "emotion_direction": "경고",
          "portrait_emotion": "stern",
          "source_line": 1732
        },
        {
          "id": "STORY_D22_COMBAT_01_002",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "전열 이동 확인. 후방 시설 대응이 늦어질 가능성 높음.",
          "emotion_direction": "분석",
          "portrait_emotion": "inquisitive",
          "source_line": 1733
        },
        {
          "id": "STORY_D22_COMBAT_01_003",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "그 계산에 내가 갑자기 네 쪽으로 뛰는 건 들어 있어?",
          "emotion_direction": "장난",
          "portrait_emotion": "eager",
          "source_line": 1734
        },
        {
          "id": "STORY_D22_COMBAT_01_004",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "지금 갱신했습니다. 아주 높음으로.",
          "emotion_direction": "당황",
          "portrait_emotion": "inquisitive",
          "source_line": 1735
        }
      ]
    },
    {
      "id": "STORY_D22_COMBAT_02",
      "day": 22,
      "title": "DAY 22 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 10
      },
      "cues": [
        {
          "id": "STORY_D22_COMBAT_02_001",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "더 나빠졌는데.",
          "emotion_direction": "건조",
          "portrait_emotion": "proud",
          "source_line": 1736
        },
        {
          "id": "STORY_D22_COMBAT_02_002",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "잡을 확률 말고 사고 칠 확률인가 봐.",
          "emotion_direction": "머쓱",
          "portrait_emotion": "eager",
          "source_line": 1737
        },
        {
          "id": "STORY_D22_COMBAT_02_003",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "곱은 조사관. 핀은 공병 경로. 푸딩은 탐험대를 묶어.",
          "emotion_direction": "지시",
          "portrait_emotion": "serious",
          "source_line": 1738
        },
        {
          "id": "STORY_D22_COMBAT_02_004",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "오늘도 다들 내 앞에서 회의하네!",
          "emotion_direction": "힘씀",
          "portrait_emotion": "brave",
          "source_line": 1739
        }
      ]
    },
    {
      "id": "STORY_D22_COMBAT_03",
      "day": 22,
      "title": "DAY 22 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 20
      },
      "cues": [
        {
          "id": "STORY_D22_COMBAT_03_001",
          "speaker_id": "NARRATOR",
          "speaker_label": "공병",
          "text_ko": "활성 시설 확인. 무력화 장치 설치 시작.",
          "emotion_direction": "집중",
          "portrait_emotion": "none",
          "source_line": 1740
        },
        {
          "id": "STORY_D22_COMBAT_03_002",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "설치 위치 보였어. 장치부터 부술게.",
          "emotion_direction": "차분",
          "portrait_emotion": "proud",
          "source_line": 1741
        },
        {
          "id": "STORY_D22_COMBAT_03_003",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "시설을 멈추면 수익도 멈춥니다. 핀에게 오늘만큼은 탄약 제한을 해제하겠습니다.",
          "emotion_direction": "다급",
          "portrait_emotion": "panic",
          "source_line": 1742
        },
        {
          "id": "STORY_D22_COMBAT_03_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "원래 제한 있었어?",
          "emotion_direction": "놀람",
          "portrait_emotion": "proud",
          "source_line": 1743
        }
      ]
    },
    {
      "id": "STORY_D22_COMBAT_04",
      "day": 22,
      "title": "DAY 22 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 30
      },
      "cues": [
        {
          "id": "STORY_D22_COMBAT_04_001",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "마음속에 있었습니다.",
          "emotion_direction": "회피",
          "portrait_emotion": "accounting",
          "source_line": 1744
        },
        {
          "id": "STORY_D22_COMBAT_04_002",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "공병 뒤로 늦은 탐험가가 하나 더 합류합니다. 도둑은 그 다음에 보물실로 향합니다.",
          "emotion_direction": "경고",
          "portrait_emotion": "stern",
          "source_line": 1745
        },
        {
          "id": "STORY_D22_COMBAT_04_003",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "시설 쪽에 병력을 전부 빼지 마. 앞을 비우면 도둑 길까지 열린다.",
          "emotion_direction": "집중",
          "portrait_emotion": "serious",
          "source_line": 1746
        },
        {
          "id": "STORY_D22_COMBAT_04_004",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "발소리 가볍고 오른쪽으로 치우쳤어. 후배네. 금고까지 가기 전에 두 번 망설일 거야.",
          "emotion_direction": "관찰",
          "portrait_emotion": "focused",
          "source_line": 1747
        }
      ]
    },
    {
      "id": "STORY_D22_COMBAT_05",
      "day": 22,
      "title": "DAY 22 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 40
      },
      "cues": [
        {
          "id": "STORY_D22_COMBAT_05_001",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "푸딩은 전열 유지. 곱, 조사관 정리되면 후방으로 돌아.",
          "emotion_direction": "명령",
          "portrait_emotion": "command",
          "source_line": 1748
        },
        {
          "id": "STORY_D22_COMBAT_05_002",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "이번엔 진짜 돌아올게!",
          "emotion_direction": "대답",
          "portrait_emotion": "eager",
          "source_line": 1749
        },
        {
          "id": "STORY_D22_COMBAT_05_003",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "오늘 두 번째로 믿어 본다!",
          "emotion_direction": "웃음",
          "portrait_emotion": "happy",
          "source_line": 1750
        },
