          "id": "STORY_D22_RESULT_WIN_008",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "끝까지 막긴 했는데, 뒤쪽은 조금 다쳤네.",
          "emotion_direction": "아쉬움",
