{
  "schema_version": 1,
  "day": 8,
  "scenes": [
    {
      "id": "STORY_D08_MANAGEMENT",
      "day": 8,
      "title": "DAY 8 · 관리 대화",
      "trigger": "management_entered",
      "delivery": "blocking",
      "repeat_policy": "once_first_cycle_day",
      "metadata": {
        "title": "관리 대화"
      },
      "cues": [
        {
          "id": "STORY_D08_MANAGEMENT_001",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "마왕님, 푸딩 몸이 전보다 단단해졌어. 어제 벽에 부딪혔는데 벽이 먼저 미안하대.",
          "emotion_direction": "신기함",
          "portrait_emotion": "happy",
          "source_line": 557
        },
        {
          "id": "STORY_D08_MANAGEMENT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "벽이 말을 했다고?",
          "emotion_direction": "놀람",
          "portrait_emotion": "flustered",
          "source_line": 558
        },
        {
          "id": "STORY_D08_MANAGEMENT_003",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "아니. 금이 쫙 가서 그렇게 보였어.",
          "emotion_direction": "고민",
          "portrait_emotion": "happy",
          "source_line": 559
        },
        {
          "id": "STORY_D08_MANAGEMENT_004",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "방금 끝난 시설 수리비가 다시 걸어 들어오고 있습니다.",
          "emotion_direction": "충격",
          "portrait_emotion": "accounting",
          "source_line": 560
        },
        {
          "id": "STORY_D08_MANAGEMENT_005",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "곱도 빨라졌다! 아침밥 먹고 그릇이 떨어지기 전에 잡았다!",
          "emotion_direction": "신남",
          "portrait_emotion": "eager",
          "source_line": 561
        },
        {
          "id": "STORY_D08_MANAGEMENT_006",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "그릇을 떨어뜨린 것도 너잖아.",
          "emotion_direction": "의심",
          "portrait_emotion": "proud",
          "source_line": 562
        },
        {
          "id": "STORY_D08_MANAGEMENT_007",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "문제 만들고 해결했다. 곱, 혼자서 두 사람 몫!",
          "emotion_direction": "뿌듯",
          "portrait_emotion": "eager",
          "source_line": 563
        },
        {
          "id": "STORY_D08_MANAGEMENT_008",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "농담처럼 보여도 실제 성장 징후가 맞습니다. 셋 모두 다음 역할로 넘어갈 준비를 시작했습니다.",
          "emotion_direction": "차분",
          "portrait_emotion": "stern",
          "source_line": 564
        }
      ]
    },
    {
      "id": "STORY_D08_PRECOMBAT",
      "day": 8,
      "title": "DAY 8 · 전투 직전",
      "trigger": "precombat_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "전투 직전"
      },
      "cues": [
        {
          "id": "STORY_D08_PRECOMBAT_001",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "내 화염구도 커졌어. 어제 시험했더니 촛불 세 개가 동시에 꺼졌지.",
          "emotion_direction": "자신만만",
          "portrait_emotion": "proud",
          "source_line": 568
        },
        {
          "id": "STORY_D08_PRECOMBAT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "불을 쐈는데 촛불이 왜 꺼지지?",
          "emotion_direction": "의아",
          "portrait_emotion": "serious",
          "source_line": 569
        },
        {
          "id": "STORY_D08_PRECOMBAT_003",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "폭발 바람이 좀 셌어. 천장 그을음은 원래 있던 거야.",
          "emotion_direction": "작게",
          "portrait_emotion": "proud",
          "source_line": 570
        },
        {
          "id": "STORY_D08_PRECOMBAT_004",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "정찰 보고입니다! 탐험가 넷, 뒤늦게 따라오는 도둑 하나를 확인했습니다.",
          "emotion_direction": "브리핑",
          "portrait_emotion": "briefing",
          "source_line": 571
        },
        {
          "id": "STORY_D08_PRECOMBAT_005",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "로로도 오늘 방어전에 들어오겠나?",
          "emotion_direction": "권유",
          "portrait_emotion": "serious",
          "source_line": 572
        },
        {
          "id": "STORY_D08_PRECOMBAT_006",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "아직은 지도를 들고 뛰는 쪽이 더 도움 됩니다. 싸우다 지도에 불붙으면 다 같이 길을 잃습니다.",
          "emotion_direction": "솔직",
          "portrait_emotion": "mischief",
          "source_line": 573
        },
        {
          "id": "STORY_D08_PRECOMBAT_007",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "왜 나를 보면서 말해?",
          "emotion_direction": "시선 회피",
          "portrait_emotion": "cast",
          "source_line": 574
        },
        {
          "id": "STORY_D08_PRECOMBAT_008",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "알겠다. 로로는 바깥길을 맡아라. 성 안은 우리가 지킨다.",
          "emotion_direction": "신뢰",
          "portrait_emotion": "serious",
          "source_line": 575
        }
      ]
    },
    {
      "id": "STORY_D08_COMBAT_01",
      "day": 8,
      "title": "DAY 8 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 0
      },
      "cues": [
        {
          "id": "STORY_D08_COMBAT_01_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "오늘은 성장을 확인하는 전투입니다. 후반의 도둑 하나를 놓치지 마십시오.",
          "emotion_direction": "집중",
          "portrait_emotion": "stern",
          "source_line": 579
        },
        {
          "id": "STORY_D08_COMBAT_01_002",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "푸딩, 어제보다 오래 막을게!",
          "emotion_direction": "용감",
          "portrait_emotion": "brave",
          "source_line": 580
        },
        {
          "id": "STORY_D08_COMBAT_01_003",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "곱도 어제보다 빨리 때릴게!",
          "emotion_direction": "경쟁심",
          "portrait_emotion": "eager",
          "source_line": 581
        },
        {
          "id": "STORY_D08_COMBAT_01_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "그럼 나는 어제보다 뜨겁게 구울게.",
          "emotion_direction": "경쟁심",
          "portrait_emotion": "proud",
          "source_line": 582
        }
      ]
    },
    {
      "id": "STORY_D08_COMBAT_02",
      "day": 8,
      "title": "DAY 8 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 10
      },
      "cues": [
        {
          "id": "STORY_D08_COMBAT_02_001",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "성장 확인이지 성을 태우는 대회가 아니다!",
          "emotion_direction": "다급",
          "portrait_emotion": "serious",
          "source_line": 583
        },
        {
          "id": "STORY_D08_COMBAT_02_002",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "후방 도둑 진입! 복도 모퉁이에서 신발 끈 묶는 중입니다!",
          "emotion_direction": "원거리 보고",
          "portrait_emotion": "briefing",
          "source_line": 584
        },
        {
          "id": "STORY_D08_COMBAT_02_003",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "기다려 줬다! 착한 도둑이다!",
          "emotion_direction": "환호",
          "portrait_emotion": "eager",
          "source_line": 585
        },
        {
          "id": "STORY_D08_COMBAT_02_004",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "착한 게 아니라 방심한 겁니다. 지금 잡으십시오.",
          "emotion_direction": "황당",
          "portrait_emotion": "stern",
          "source_line": 586
        }
      ]
    },
    {
      "id": "STORY_D08_RESULT_WIN",
      "day": 8,
      "title": "DAY 8 · 승리 결산",
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "승리 결산"
      },
      "cues": [
        {
          "id": "STORY_D08_RESULT_WIN_001",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "진짜 더 오래 버텼어! 푸딩, 나중엔 입구를 혼자 꽉 막을 수 있을까?",
          "emotion_direction": "기쁨",
          "portrait_emotion": "happy",
          "source_line": 590
        },
        {
          "id": "STORY_D08_RESULT_WIN_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "혼자 막을 필요는 없다. 그래도 네가 원한다면 누구보다 든든해질 거다.",
          "emotion_direction": "다정",
          "portrait_emotion": "serious",
          "source_line": 591
        },
        {
          "id": "STORY_D08_RESULT_WIN_003",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "곱은 도망가는 적 전부 잡는 곱 된다!",
          "emotion_direction": "기대",
          "portrait_emotion": "eager",
          "source_line": 592
        },
        {
          "id": "STORY_D08_RESULT_WIN_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "나는 둘이 붙잡은 적을 한 번에 끝내는 핀이 될 거고.",
          "emotion_direction": "미소",
          "portrait_emotion": "proud",
          "source_line": 593
        },
        {
          "id": "STORY_D08_RESULT_WIN_005",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "저는 그 이야기를 세 배로 부풀려서 마을에 퍼뜨리겠습니다.",
          "emotion_direction": "장난",
          "portrait_emotion": "mischief",
          "source_line": 594
        },
        {
          "id": "STORY_D08_RESULT_WIN_006",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "세 배는 과장 광고입니다.",
          "emotion_direction": "경고",
          "portrait_emotion": "accounting",
          "source_line": 595
        },
        {
          "id": "STORY_D08_RESULT_WIN_007",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "두 배 반으로 합의하시죠.",
          "emotion_direction": "태연",
          "portrait_emotion": "mischief",
          "source_line": 596
        },
        {
          "id": "STORY_D08_RESULT_WIN_008",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "과장할 필요가 없을지도 모릅니다. 왕국이 정식 조사관 아이리스를 보내고 있습니다.",
          "emotion_direction": "예고",
          "portrait_emotion": "stern",
          "source_line": 597
        }
      ]
    }
  ]
}
