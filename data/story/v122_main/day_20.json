{
  "schema_version": 1,
  "day": 20,
  "scenes": [
    {
      "id": "STORY_D20_MANAGEMENT",
      "day": 20,
      "title": "DAY 20 · 관리 대화",
      "trigger": "management_entered",
      "delivery": "blocking",
      "repeat_policy": "once_first_cycle_day",
      "metadata": {
        "title": "관리 대화"
      },
      "cues": [
        {
          "id": "STORY_D20_MANAGEMENT_001",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "왕좌 공격 기록보다 병영과 감시초소 작동 시간을 먼저 조사했습니다.",
          "emotion_direction": "냉정함",
          "portrait_emotion": "stern",
          "source_line": 1536
        },
        {
          "id": "STORY_D20_MANAGEMENT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "남의 집 시설 사용 시간까지 적어갔어?",
          "emotion_direction": "못마땅",
          "portrait_emotion": "serious",
          "source_line": 1537
        },
        {
          "id": "STORY_D20_MANAGEMENT_003",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "점검표에 항목이 있었습니다.",
          "emotion_direction": "담담함",
          "portrait_emotion": "inquisitive",
          "source_line": 1538
        },
        {
          "id": "STORY_D20_MANAGEMENT_004",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "오늘은 공병 두 명이 서로 다른 시설로 파고들어 잠시 작동을 멈출 겁니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 1539
        },
        {
          "id": "STORY_D20_MANAGEMENT_005",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "시설이 멈춘 동안도 유지비는 나갑니까?",
          "emotion_direction": "경악",
          "portrait_emotion": "panic",
          "source_line": 1540
        },
        {
          "id": "STORY_D20_MANAGEMENT_006",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "나갑니다.",
          "emotion_direction": "무표정",
          "portrait_emotion": "stern",
          "source_line": 1541
        },
        {
          "id": "STORY_D20_MANAGEMENT_007",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "공병부터 잡으십시오. 이것은 개인적인 요청입니다.",
          "emotion_direction": "분노",
          "portrait_emotion": "accounting",
          "source_line": 1542
        },
        {
          "id": "STORY_D20_MANAGEMENT_008",
          "speaker_id": "CHR_ROMAN",
          "speaker_label": "로만",
          "text_ko": "왕국 보급 책임자 로만입니다. 기존 현장 보고 양식에 오류가 많아 직접 확인하러 왔습니다.",
          "emotion_direction": "공손함",
          "portrait_emotion": "formal",
          "source_line": 1543
        },
        {
          "id": "STORY_D20_MANAGEMENT_009",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "보스가 싸우러 오면서 양식부터 따져?",
          "emotion_direction": "황당",
          "portrait_emotion": "serious",
          "source_line": 1544
        },
        {
          "id": "STORY_D20_MANAGEMENT_010",
          "speaker_id": "CHR_ROMAN",
          "speaker_label": "로만",
          "text_ko": "칼은 휘두르면 끝나지만 잘못된 양식은 부서 전체에 남습니다.",
          "emotion_direction": "진지",
          "portrait_emotion": "formal",
          "source_line": 1545
        },
        {
          "id": "STORY_D20_MANAGEMENT_011",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "무서운 사람이네.",
          "emotion_direction": "작게 감탄",
          "portrait_emotion": "proud",
          "source_line": 1546
        },
        {
          "id": "STORY_D20_MANAGEMENT_012",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "글자로 공격하는 보스면 나는 어떡하지?",
          "emotion_direction": "속삭임",
          "portrait_emotion": "eager",
          "source_line": 1547
        }
      ]
    },
    {
      "id": "STORY_D20_PRECOMBAT",
      "day": 20,
      "title": "DAY 20 · 전투 직전",
      "trigger": "precombat_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "전투 직전"
      },
      "cues": [
        {
          "id": "STORY_D20_PRECOMBAT_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "첫 공병이 시설로 빠지고, 전열이 흔들릴 때쯤 두 번째가 다른 방을 노릴 겁니다. 움직이는 방향을 놓치지 마십시오.",
          "emotion_direction": "전술적",
          "portrait_emotion": "stern",
          "source_line": 1551
        },
        {
          "id": "STORY_D20_PRECOMBAT_002",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "한 명을 놓치면 시설이 계속 멈춰요?",
          "emotion_direction": "걱정",
          "portrait_emotion": "happy",
          "source_line": 1552
        },
        {
          "id": "STORY_D20_PRECOMBAT_003",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "아닙니다. 무력화는 잠시 뒤 풀립니다. 다만 그동안 전선이 흔들립니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 1553
        },
        {
          "id": "STORY_D20_PRECOMBAT_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "영원히 꺼지는 게 아니라면 다시 불붙이면 돼.",
          "emotion_direction": "여유",
          "portrait_emotion": "proud",
          "source_line": 1554
        },
        {
          "id": "STORY_D20_PRECOMBAT_005",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "꺼지게 두지 않는 편이 더 쌉니다.",
          "emotion_direction": "단호함",
          "portrait_emotion": "accounting",
          "source_line": 1555
        },
        {
          "id": "STORY_D20_PRECOMBAT_006",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "공병 뒤에 숨어서 장기전을 만들 생각인가?",
          "emotion_direction": "로만을 보며",
          "portrait_emotion": "serious",
          "source_line": 1556
        },
        {
          "id": "STORY_D20_PRECOMBAT_007",
          "speaker_id": "CHR_ROMAN",
          "speaker_label": "로만",
          "text_ko": "‘숨는다’가 아니라 ‘지휘 위치를 유지한다’입니다. 살아 있는 왕국군에는 회복과 방호 물자를 배부하겠습니다.",
          "emotion_direction": "담담함",
          "portrait_emotion": "formal",
          "source_line": 1557
        },
        {
          "id": "STORY_D20_PRECOMBAT_008",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "말이 전부 보고서 같아.",
          "emotion_direction": "질색",
          "portrait_emotion": "eager",
          "source_line": 1558
        },
        {
          "id": "STORY_D20_PRECOMBAT_009",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "네 말은 전부 낙서 같으니까 균형이 맞네.",
          "emotion_direction": "빈정거림",
          "portrait_emotion": "proud",
          "source_line": 1559
        },
        {
          "id": "STORY_D20_PRECOMBAT_010",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "공병이 갈라지면 곱이 추격한다. 푸딩은 전열, 핀은 지휘선이 열리는 순간 로만에게 집중.",
          "emotion_direction": "집중",
          "portrait_emotion": "serious",
          "source_line": 1560
        },
        {
          "id": "STORY_D20_PRECOMBAT_011",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "개별 적이 아니라 전투 순서를 보고 계시는군요.",
          "emotion_direction": "옅은 만족",
          "portrait_emotion": "stern",
          "source_line": 1561
        },
        {
          "id": "STORY_D20_PRECOMBAT_012",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "오늘은 방 하나가 아니라 이 성 전체를 지켜야 하니까.",
          "emotion_direction": "결연함",
          "portrait_emotion": "serious",
          "source_line": 1562
        }
      ]
    },
    {
      "id": "STORY_D20_COMBAT_01",
      "day": 20,
      "title": "DAY 20 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 0
      },
      "cues": [
        {
          "id": "STORY_D20_COMBAT_01_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "첫 공병이 전선에서 빠졌습니다. 어느 방으로 향하는지 보십시오.",
          "emotion_direction": "경고",
          "portrait_emotion": "stern",
          "source_line": 1566
        },
        {
          "id": "STORY_D20_COMBAT_01_002",
          "speaker_id": "NARRATOR",
          "speaker_label": "공병",
          "text_ko": "작동 시설 확인. 무력화 작업 시작!",
          "emotion_direction": "집중",
          "portrait_emotion": "none",
          "source_line": 1567
        },
        {
          "id": "STORY_D20_COMBAT_01_003",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "남의 시설 만지기 전에 사용 신청서부터 써!",
          "emotion_direction": "맹렬함",
          "portrait_emotion": "eager",
          "source_line": 1568
        },
        {
          "id": "STORY_D20_COMBAT_01_004",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "훌륭한 지적입니다!",
          "emotion_direction": "흥분",
          "portrait_emotion": "accounting",
          "source_line": 1569
        }
      ]
    },
    {
      "id": "STORY_D20_COMBAT_02",
      "day": 20,
      "title": "DAY 20 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 10
      },
      "cues": [
        {
          "id": "STORY_D20_COMBAT_02_001",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "방패병이 붙었어요! 곱이 돌아올 때까지 제가 잡고 있을게요!",
          "emotion_direction": "버팀",
          "portrait_emotion": "happy",
          "source_line": 1570
        },
        {
          "id": "STORY_D20_COMBAT_02_002",
          "speaker_id": "NARRATOR",
          "speaker_label": "공병",
          "text_ko": "저쪽은 이미 멈췄다! 다른 방으로 간다!",
          "emotion_direction": "지휘",
          "portrait_emotion": "none",
          "source_line": 1571
        },
        {
          "id": "STORY_D20_COMBAT_02_003",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "둘이 다른 곳으로 갈라져. 마왕님, 어느 쪽부터?",
          "emotion_direction": "집중",
          "portrait_emotion": "cast",
          "source_line": 1572
        },
        {
          "id": "STORY_D20_COMBAT_02_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "지금 전열을 살리는 시설부터 지켜! 놓친 쪽은 작동이 돌아올 때까지 버틴다!",
          "emotion_direction": "즉시 판단",
          "portrait_emotion": "serious",
          "source_line": 1573
        }
      ]
    },
    {
      "id": "STORY_D20_COMBAT_03",
      "day": 20,
      "title": "DAY 20 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 20
      },
      "cues": [
        {
          "id": "STORY_D20_COMBAT_03_001",
          "speaker_id": "CHR_ROMAN",
          "speaker_label": "로만",
          "text_ko": "곧 지휘선에 합류합니다. 부상 보고서와 방어 물자는 제 양식대로 다시 배부합니다.",
          "emotion_direction": "진입",
          "portrait_emotion": "formal",
          "source_line": 1574
        },
        {
          "id": "STORY_D20_COMBAT_03_002",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "회복에도 양식이 필요해?",
          "emotion_direction": "어이없음",
          "portrait_emotion": "proud",
          "source_line": 1575
        },
        {
          "id": "STORY_D20_COMBAT_03_003",
          "speaker_id": "CHR_ROMAN",
          "speaker_label": "로만",
          "text_ko": "미작성자는 지급 대상에서 제외됩니다.",
          "emotion_direction": "엄정함",
          "portrait_emotion": "formal",
          "source_line": 1576
        },
        {
          "id": "STORY_D20_COMBAT_03_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "그럼 네 양식에 이것도 적어. ‘마왕성, 보급 책임자 반송.’",
          "emotion_direction": "도발",
          "portrait_emotion": "serious",
          "source_line": 1577
        }
      ]
    },
    {
      "id": "STORY_D20_RESULT_WIN",
      "day": 20,
      "title": "DAY 20 · 승리 결산",
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "승리 결산"
      },
      "cues": [
        {
          "id": "STORY_D20_RESULT_WIN_001",
          "speaker_id": "CHR_ROMAN",
          "speaker_label": "로만",
          "text_ko": "공병 연락 두절, 방호 물자 소진, 지휘선 붕괴… 수치가 맞지 않는군요.",
          "emotion_direction": "숨을 고르며",
          "portrait_emotion": "exhausted_command",
          "source_line": 1581
        },
        {
          "id": "STORY_D20_RESULT_WIN_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "싸움이 늘 장부대로 끝나진 않거든.",
          "emotion_direction": "피곤한 웃음",
          "portrait_emotion": "serious",
          "source_line": 1582
        },
        {
          "id": "STORY_D20_RESULT_WIN_003",
          "speaker_id": "CHR_ROMAN",
          "speaker_label": "로만",
          "text_ko": "그렇군요. 이곳은 임시 소굴이 아니라 독자적으로 유지되는 전투 거점입니다.",
          "emotion_direction": "마지못한 인정",
          "portrait_emotion": "exhausted_command",
          "source_line": 1583
        },
        {
          "id": "STORY_D20_RESULT_WIN_004",
          "speaker_id": "CHR_ROMAN",
          "speaker_label": "로만",
          "text_ko": "적의 보급을 끊으면서 자기 전선은 살렸군요. 당신의 운영은 보고서보다 훨씬 정확했습니다.",
          "emotion_direction": "바티를 보며",
          "portrait_emotion": "formal",
          "source_line": 1584
        },
        {
          "id": "STORY_D20_RESULT_WIN_005",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "당신도 무너지기 전에 병력을 먼저 물렸습니다. 오래 실무를 맡은 사람끼리는 보이는 것이 있지요.",
          "emotion_direction": "담담한 존중",
          "portrait_emotion": "dry",
          "source_line": 1585
        },
        {
          "id": "STORY_D20_RESULT_WIN_006",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "적이지만 회계 판단은 정확합니다.",
          "emotion_direction": "만족",
          "portrait_emotion": "relieved",
          "source_line": 1586
        },
        {
          "id": "STORY_D20_RESULT_WIN_007",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "데려다 고용할까?",
          "emotion_direction": "장난기",
          "portrait_emotion": "proud",
          "source_line": 1587
        },
        {
          "id": "STORY_D20_RESULT_WIN_008",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "급여 협상부터 해보겠습니다.",
          "emotion_direction": "즉답",
          "portrait_emotion": "accounting",
          "source_line": 1588
        },
        {
          "id": "STORY_D20_RESULT_WIN_009",
          "speaker_id": "CHR_ROMAN",
          "speaker_label": "로만",
          "text_ko": "포로 상태의 채용 제안은 왕국 근로 규정 위반입니다.",
          "emotion_direction": "단호함",
          "portrait_emotion": "formal",
          "source_line": 1589
        },
        {
          "id": "STORY_D20_RESULT_WIN_010",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "졌는데도 규정 얘기하네.",
          "emotion_direction": "황당",
          "portrait_emotion": "eager",
          "source_line": 1590
        },
        {
          "id": "STORY_D20_RESULT_WIN_011",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "마왕님, 성이 움직여요. 벽도, 시설도 전부 달라지고 있어요!",
          "emotion_direction": "감격",
          "portrait_emotion": "happy",
          "source_line": 1591
        },
        {
