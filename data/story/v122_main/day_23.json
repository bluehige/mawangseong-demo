          "source_line": 1850,
          "speaker_role": "first_promoted"
        },
        {
          "id": "STORY_D23_RESULT_WIN_004",
          "speaker_id": "NARRATOR",
          "speaker_label": "나머지몬스터",
          "text_ko": "멋있는 표정은 나중에. 정리부터 도와.",
