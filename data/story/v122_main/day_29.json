          "id": "STORY_D29_MANAGEMENT_123",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "마지막 선언을 선택하십시오.",
          "emotion_direction": "안내",
          "portrait_emotion": "tutorial",
          "source_line": 2445
        },
