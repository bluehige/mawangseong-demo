          "id": "STORY_D29_MANAGEMENT_124",
          "speaker_id": "NARRATOR",
          "speaker_label": "시스템",
		  "text_ko": "최후 선언 — ‘라이벌 약속’, ‘성 수호’, 자격을 갖췄다면 ‘휴전문 제안’ 중 하나.",
		  "emotion_direction": "선택",
		  "portrait_emotion": "none",
		  "source_line": 2446
		}
	  ]
