          "portrait_emotion": "command",
          "source_line": 2181
        },
        {
          "id": "STORY_D27_RESULT_WIN_017",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "왕국의 최종 공성 준비도 시작됐습니다. 내일 마지막 원정으로 결전의 조건을 선택해야 합니다.",
          "emotion_direction": "예고",
