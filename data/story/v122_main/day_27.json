        {
          "id": "STORY_D27_RESULT_WIN_002",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "마력 배선 연결, 보조 건물 확장, 열한 구역 공사비 반영…",
