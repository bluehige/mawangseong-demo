        {
          "id": "STORY_D27_RESULT_WIN_010",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "처음엔 의자 하나와 눅눅한 바닥뿐이었는데.",
