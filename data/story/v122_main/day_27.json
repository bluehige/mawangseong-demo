        },
        {
          "id": "STORY_D27_RESULT_WIN_013",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "네가 헤맬 길도 열한 배.",
          "emotion_direction": "미소",
          "portrait_emotion": "proud",
          "source_line": 2178
        },
        {
          "id": "STORY_D27_RESULT_WIN_014",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "훔칠 곳도 열한 배네.",
          "emotion_direction": "휘파람",
