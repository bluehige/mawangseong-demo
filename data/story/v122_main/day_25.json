      "cues": [
        {
          "id": "STORY_D25_COMBAT_06_001",
          "speaker_id": "CHR_HERO_LEON",
          "speaker_label": "레온",
          "text_ko": "이번에는 끝까지 간다!",
          "emotion_direction": "기합",
          "portrait_emotion": "determined",
          "source_line": 2000
        },
        {
          "id": "STORY_D25_COMBAT_06_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "우리도 끝까지 막는다!",
          "emotion_direction": "명령",
          "portrait_emotion": "command",
          "source_line": 2001
        }
      ]
    },
    {
      "id": "STORY_D25_RESULT_WIN",
      "day": 25,
      "title": "DAY 25 · 승리 결산",
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "승리 결산"
      },
      "cues": [
        {
          "id": "STORY_D25_RESULT_WIN_001",
          "speaker_id": "CHR_HERO_LEON",
          "speaker_label": "레온",
          "text_ko": "아직… 끝까지 못 갔는데.",
          "emotion_direction": "숨참",
          "portrait_emotion": "determined",
          "source_line": 2005
        },
        {
          "id": "STORY_D25_RESULT_WIN_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "첫날엔 입구에서 길을 잃었지. 많이 왔어.",
          "emotion_direction": "숨고름",
          "portrait_emotion": "serious",
          "source_line": 2006
        },
        {
          "id": "STORY_D25_RESULT_WIN_003",
          "speaker_id": "CHR_HERO_LEON",
          "speaker_label": "레온",
          "text_ko": "칭찬인지 놀림인지 모르겠습니다.",
          "emotion_direction": "쓴웃음",
          "portrait_emotion": "determined",
          "source_line": 2007
        },
        {
          "id": "STORY_D25_RESULT_WIN_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "둘 다다. 하지만 오늘은 놀림보다 칭찬이 조금 더 커.",
          "emotion_direction": "솔직",
          "portrait_emotion": "serious",
          "source_line": 2008
        },
        {
          "id": "STORY_D25_RESULT_WIN_005",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "레온과 지원대 전원 전투 불능. 두 번째 도전을 막았습니다.",
          "emotion_direction": "확인",
          "portrait_emotion": "stern",
          "source_line": 2009
        },
        {
          "id": "STORY_D25_RESULT_WIN_006",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "해냈다!",
          "emotion_direction": "기쁨",
          "portrait_emotion": "happy",
          "source_line": 2010
        },
        {
          "id": "STORY_D25_RESULT_WIN_007",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "공병도 잡고 돌아왔어. 진짜로.",
          "emotion_direction": "뿌듯",
          "portrait_emotion": "eager",
          "source_line": 2011
        },
        {
          "id": "STORY_D25_RESULT_WIN_008",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "오늘은 세어 보니 한 번에 돌아왔네.",
          "emotion_direction": "미소",
          "portrait_emotion": "proud",
          "source_line": 2012
        },
        {
          "id": "STORY_D25_RESULT_WIN_009",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "시설 피해는 지금 계산하겠습니다. 레온, 문짝 수리비는 결과와 별도로 청구합니다.",
          "emotion_direction": "장부확인",
          "portrait_emotion": "accounting",
          "source_line": 2013
        },
        {
          "id": "STORY_D25_RESULT_WIN_010",
          "speaker_id": "CHR_HERO_LEON",
          "speaker_label": "레온",
          "text_ko": "졌는데 할인에 감사해야 합니까?",
          "emotion_direction": "어이없음",
          "portrait_emotion": "determined",
          "source_line": 2014
        },
        {
          "id": "STORY_D25_RESULT_WIN_011",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "감사는 무료입니다.",
          "emotion_direction": "진지",
          "portrait_emotion": "accounting",
          "source_line": 2015
        },
        {
          "id": "STORY_D25_RESULT_WIN_012",
          "speaker_id": "CHR_HERO_LEON",
          "speaker_label": "레온",
          "text_ko": "다음에는 견습이라는 말 없이 돌아오겠습니다.",
          "emotion_direction": "마왕을봄",
          "portrait_emotion": "determined",
          "source_line": 2016
        },
        {
          "id": "STORY_D25_RESULT_WIN_013",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "그럼 나도 임시 소굴 주인 같은 얼굴로 기다리진 않지.",
          "emotion_direction": "진지",
          "portrait_emotion": "serious",
          "source_line": 2017
        },
        {
          "id": "STORY_D25_RESULT_WIN_014",
          "speaker_id": "CHR_HERO_LEON",
          "speaker_label": "레온",
          "text_ko": "그때까지 누구에게도 지지 마십시오. 제가 정식 용사가 되어 이 성의 끝까지 가겠습니다.",
          "emotion_direction": "결의",
          "portrait_emotion": "determined",
          "source_line": 2018
        },
        {
          "id": "STORY_D25_RESULT_WIN_015",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "너도 중간에 쓰러지지 마. 내 라이벌 자리가 비면 곤란하니까.",
          "emotion_direction": "인정",
          "portrait_emotion": "soft",
          "source_line": 2019
        },
        {
          "id": "STORY_D25_RESULT_WIN_016",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "레온의 전투 보고를 왕국 회의에 제출합니다. 마왕성 위협 등급의 공식 재심사가 시작될 겁니다.",
          "emotion_direction": "전언",
          "portrait_emotion": "formal",
          "source_line": 2020
        },
        {
          "id": "STORY_D25_RESULT_WIN_017",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "왕국이 더는 이곳을 장난스러운 소굴로 분류하지 않습니다.",
          "emotion_direction": "예고",
          "portrait_emotion": "stern",
          "source_line": 2021
        },
        {
          "id": "STORY_D25_RESULT_WIN_018",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "좋아. 내일부터는 이름에 맞는 손님을 받도록 하지.",
          "emotion_direction": "결의",
          "portrait_emotion": "command",
          "source_line": 2022
        }
      ]
    }
