{
  "schema_version": 1,
  "day": 1,
  "scenes": [
    {
      "id": "STORY_D01_MANAGEMENT_ENTRY",
      "day": 1,
      "trigger": "management_entered",
      "delivery": "blocking",
      "repeat_policy": "once_first_cycle_day",
      "metadata": {
        "source_section": "관리 전 대화"
      },
      "cues": [
        {
          "id": "STORY_D01_MANAGEMENT_ENTRY_001",
          "speaker_id": "NARRATOR",
          "speaker_label": "내레이션",
          "text_ko": "깊은 산속, 지도에는 점 하나로 찍혀 있고 배달 기사들은 점마저 못 찾는 동굴이 있었다.",
          "emotion_direction": "담담",
          "portrait_emotion": "none",
          "source_line": 68
        },
        {
          "id": "STORY_D01_MANAGEMENT_ENTRY_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "크흠. 오늘부터 이곳은 내 마왕성이다. 왕국이 두려움에 떨 날도 머지않았다!",
          "emotion_direction": "비장",
          "portrait_emotion": "proud",
          "source_line": 69
        },
        {
          "id": "STORY_D01_MANAGEMENT_ENTRY_003",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "왕국보다 먼저 천장에서 물방울이 떨고 있습니다.",
          "emotion_direction": "건조",
          "portrait_emotion": "dry",
          "source_line": 70
        },
        {
          "id": "STORY_D01_MANAGEMENT_ENTRY_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "저건 공포 연출이다. 동굴 전체가 긴장해서 식은땀을 흘리는 거지.",
          "emotion_direction": "당황",
          "portrait_emotion": "flustered",
          "source_line": 71
        },
        {
          "id": "STORY_D01_MANAGEMENT_ENTRY_005",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "공포 연출 유지비로 양동이 두 개가 필요합니다. 현재 예산으로는 한 개만 가능합니다.",
          "emotion_direction": "계산",
          "portrait_emotion": "accounting",
          "source_line": 72
        },
        {
          "id": "STORY_D01_MANAGEMENT_ENTRY_006",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "마왕이 됐는데 첫 회의가 왜 누수 대책 회의냐?",
          "emotion_direction": "억울",
          "portrait_emotion": "offended",
          "source_line": 73
        },
        {
          "id": "STORY_D01_MANAGEMENT_ENTRY_007",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "왕좌가 젖으면 곰팡이가 생기고, 곰팡이가 생기면 권위도 미끄러집니다.",
          "emotion_direction": "무심",
          "portrait_emotion": "dry",
          "source_line": 74
        },
        {
          "id": "STORY_D01_MANAGEMENT_ENTRY_008",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "좋아. 왕좌도 지키고, 부하도 지키고, 내 권위는 일단 안 미끄러지게 붙잡겠다.",
          "emotion_direction": "결심",
          "portrait_emotion": "determined",
          "source_line": 75
        }
      ]
    },
    {
      "id": "STORY_D01_PLACEMENT_FRONT",
      "day": 1,
      "trigger": "placement_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "conditions": {
        "all": [
          {
            "fact": "gob_formation",
            "op": "eq",
            "value": "front"
          }
        ]
      },
      "metadata": {
        "source_section": "선택/분기 메모",
        "branch_group": "gob_formation",
        "branch_mode": "exclusive",
        "branch_value": "front"
      },
      "cues": [
        {
          "id": "STORY_D01_PLACEMENT_FRONT_001",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "푸딩 옆이다! 곱, 말랑한 벽 옆의 안 말랑한 주먹 한다!",
          "emotion_direction": "용감",
          "portrait_emotion": "eager",
          "source_line": 114
        },
        {
          "id": "STORY_D01_PLACEMENT_FRONT_002",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "둘이 막으면 두 배로 안 지나가!",
          "emotion_direction": "반가움",
          "portrait_emotion": "happy",
          "source_line": 115
        }
      ]
    },
    {
      "id": "STORY_D01_PLACEMENT_REAR",
      "day": 1,
      "trigger": "placement_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "conditions": {
        "all": [
          {
            "fact": "gob_formation",
            "op": "eq",
            "value": "rear"
          }
        ]
      },
      "metadata": {
        "source_section": "선택/분기 메모",
        "branch_group": "gob_formation",
        "branch_mode": "exclusive",
        "branch_value": "rear"
      },
      "cues": [
        {
          "id": "STORY_D01_PLACEMENT_REAR_001",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "핀 옆이다! 불 피한 녀석은 곱이 때린다!",
          "emotion_direction": "신남",
          "portrait_emotion": "eager",
          "source_line": 117
        },
        {
          "id": "STORY_D01_PLACEMENT_REAR_002",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "좋아. 나는 굽고 넌 뒤집어. 완벽한 조리 순서야.",
          "emotion_direction": "흡족",
          "portrait_emotion": "proud",
          "source_line": 118
        }
      ]
    },
    {
      "id": "STORY_D01_PRECOMBAT",
      "day": 1,
      "trigger": "precombat_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "source_section": "전투 직전 대화"
      },
      "cues": [
        {
          "id": "STORY_D01_PRECOMBAT_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "푸딩은 앞이 제자리입니다. 몸으로 길을 막는 데는 그곳이 가장 잘 맞습니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 79
        },
        {
          "id": "STORY_D01_PRECOMBAT_002",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "푸딩, 잘 막아! 길도 막고, 바람도 막고, 급하면 대화도 막아!",
          "emotion_direction": "신남",
          "portrait_emotion": "happy",
          "source_line": 80
        },
        {
          "id": "STORY_D01_PRECOMBAT_003",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "핀은 뒤에서 쏩니다. 앞에 세우면 적보다 우리 뒤통수가 더 위험합니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 81
        },
        {
          "id": "STORY_D01_PRECOMBAT_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "안전거리 확보 완료. 이제 저쪽만 안전하지 않게 만들면 되지?",
          "emotion_direction": "자신만만",
          "portrait_emotion": "proud",
          "source_line": 82
        },
        {
          "id": "STORY_D01_PRECOMBAT_005",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "곱은 어디? 앞에서 막아? 뒤에서 때려? 둘 다 하면 안 돼?",
          "emotion_direction": "들뜸",
          "portrait_emotion": "eager",
          "source_line": 83
        },
        {
          "id": "STORY_D01_PRECOMBAT_006",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "곱은 내가 정한다. 푸딩 옆에서 길을 막을지, 핀 옆에서 화력을 보탤지.",
          "emotion_direction": "고민",
          "portrait_emotion": "serious",
          "source_line": 84
        },
        {
          "id": "STORY_D01_PRECOMBAT_007",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "그리고 모두에게 내릴 지침은 ‘사수’입니다. 오늘은 제자리를 지키는 것부터 배우십시오.",
          "emotion_direction": "단호",
          "portrait_emotion": "stern",
          "source_line": 85
        },
        {
          "id": "STORY_D01_PRECOMBAT_008",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "알았다. 곱, 자리 사수한다. 그런데 자리가 도망가면 잡아도 돼?",
          "emotion_direction": "진지한 척",
          "portrait_emotion": "eager",
          "source_line": 86
        }
      ]
    },
    {
      "id": "STORY_D01_COMBAT_TIME_01",
      "day": 1,
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "source_section": "전투 중 짧은 대화",
        "time_seconds": 0
      },
      "cues": [
        {
          "id": "STORY_D01_COMBAT_TIME_01_001",
          "speaker_id": "CHR_EXPLORER_MILO",
          "speaker_label": "밀로",
          "text_ko": "여기가 소문난 수상한 구멍인가요? 안녕하세요. 혹시 오늘 무너지실 예정인가요?",
          "emotion_direction": "호기심",
          "portrait_emotion": "curious",
          "source_line": 90
        },
        {
          "id": "STORY_D01_COMBAT_TIME_01_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "구멍이 아니다! 아직 외벽 설치 전인 마왕성이다!",
          "emotion_direction": "발끈",
          "portrait_emotion": "offended_proud",
          "source_line": 91
        }
      ]
    },
    {
      "id": "STORY_D01_COMBAT_TIME_02",
      "day": 1,
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "source_section": "전투 중 짧은 대화",
        "time_seconds": 8
      },
      "cues": [
        {
          "id": "STORY_D01_COMBAT_TIME_02_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "침입자는 탐험가 밀로입니다. 호기심이 많고 눈치가 조금 부족합니다.",
          "emotion_direction": "냉정",
          "portrait_emotion": "stern",
          "source_line": 92
        },
        {
          "id": "STORY_D01_COMBAT_TIME_02_002",
          "speaker_id": "CHR_EXPLORER_MILO",
          "speaker_label": "밀로",
          "text_ko": "오, 앞에는 말랑한 벽이 있고 뒤에서는 불이 날아오네요. 독특한 환영식이군요.",
          "emotion_direction": "감탄",
          "portrait_emotion": "curious",
          "source_line": 93
        }
      ]
    },
    {
      "id": "STORY_D01_COMBAT_TIME_03",
      "day": 1,
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "source_section": "전투 중 짧은 대화",
        "time_seconds": 16
      },
      "cues": [
        {
          "id": "STORY_D01_COMBAT_TIME_03_001",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "푸딩은 벽 아니야! 벽보다 귀엽고, 벽보다 잘 튕겨!",
          "emotion_direction": "용감",
          "portrait_emotion": "brave",
          "source_line": 94
        },
        {
          "id": "STORY_D01_COMBAT_TIME_03_002",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "환영식 맞아. 선물은 화염구고, 교환과 환불은 안 돼.",
          "emotion_direction": "장난",
          "portrait_emotion": "proud",
          "source_line": 95
        }
      ]
    },
    {
      "id": "STORY_D01_COMBAT_TIME_04",
      "day": 1,
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "source_section": "전투 중 짧은 대화",
        "time_seconds": 24
      },
      "cues": [
        {
          "id": "STORY_D01_COMBAT_TIME_04_001",
          "speaker_id": "CHR_EXPLORER_MILO",
          "speaker_label": "밀로",
          "text_ko": "잠깐만요. 조사서 제목을 ‘별일 없는 동굴’에서 ‘별일이 너무 많은 동굴’로 고칠게요!",
          "emotion_direction": "당황",
          "portrait_emotion": "panic",
          "source_line": 96
        },
        {
          "id": "STORY_D01_COMBAT_TIME_04_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "마지막 단어도 고쳐라. 동굴이 아니라 마왕성이다. 별 세 개짜리로 써라!",
          "emotion_direction": "우쭐",
          "portrait_emotion": "proud",
          "source_line": 97
        }
      ]
    },
    {
      "id": "STORY_D01_RESULT_WIN",
      "day": 1,
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "source_section": "승리 후 대화"
      },
      "cues": [
        {
          "id": "STORY_D01_RESULT_WIN_001",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "이겼다! 첫날부터 승리라니, 역시 나는 타고난 마왕이군!",
          "emotion_direction": "환희",
          "portrait_emotion": "proud",
          "source_line": 101
        },
        {
          "id": "STORY_D01_RESULT_WIN_002",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "정확히는 부하 셋이 싸웠고 마왕님은 왕좌 옆에서 크게 응원하셨습니다.",
          "emotion_direction": "건조",
          "portrait_emotion": "dry",
          "source_line": 102
        },
        {
          "id": "STORY_D01_RESULT_WIN_003",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "지휘관의 목소리도 전력이다. 내 목은 지금 아주 전투적으로 쉬었다.",
          "emotion_direction": "태연",
          "portrait_emotion": "recover_pride",
          "source_line": 103
        },
        {
          "id": "STORY_D01_RESULT_WIN_004",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "정산 끝났습니다. 악명과 금화가 조금 늘었고, 목캔디 비용이 조금 줄었습니다.",
          "emotion_direction": "계산",
          "portrait_emotion": "accounting",
          "source_line": 104
        },
        {
          "id": "STORY_D01_RESULT_WIN_005",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "우리 집 지켰다! 이제 여기 진짜 우리 집 맞지?",
          "emotion_direction": "기쁨",
          "portrait_emotion": "happy",
          "source_line": 105
        },
        {
          "id": "STORY_D01_RESULT_WIN_006",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "그래. 작고 축축해도 우리가 지킨 곳이면 우리 성이다.",
          "emotion_direction": "부드러움",
          "portrait_emotion": "soft",
          "source_line": 106
        },
        {
          "id": "STORY_D01_RESULT_WIN_007",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "그럼 내일도 누가 와? 곱, 오늘보다 더 지금 때릴 수 있어?",
          "emotion_direction": "기대",
          "portrait_emotion": "eager",
          "source_line": 107
        },
        {
          "id": "STORY_D01_RESULT_WIN_008",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "보물 보관실 개방 소식이 새어 나갔습니다. 내일 손님은 문보다 금고에 관심이 많을 겁니다.",
          "emotion_direction": "의심",
          "portrait_emotion": "dry",
          "source_line": 108
        }
      ]
    },
    {
      "id": "STORY_D01_RESULT_LOSS",
      "day": 1,
      "trigger": "result_loss",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "source_section": "선택/분기 메모"
      },
      "cues": [
        {
          "id": "STORY_D01_RESULT_LOSS_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "왕좌가 부서졌습니다. 첫날부터 부동산 소유권이 흔들리고 있습니다.",
          "emotion_direction": "엄중",
          "portrait_emotion": "stern",
          "source_line": 120
        },
        {
          "id": "STORY_D01_RESULT_LOSS_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "왕좌 할부도 아직 안 끝났는데!",
          "emotion_direction": "절망",
          "portrait_emotion": "deflated",
          "source_line": 121
        }
      ]
    }
  ]
}
