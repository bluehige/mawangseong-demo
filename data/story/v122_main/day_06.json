{
  "schema_version": 1,
  "day": 6,
  "scenes": [
    {
      "id": "STORY_D06_MANAGEMENT",
      "day": 6,
      "title": "DAY 6 · 관리 대화",
      "trigger": "management_entered",
      "delivery": "blocking",
      "repeat_policy": "once_first_cycle_day",
      "metadata": {
        "title": "관리 대화"
      },
      "cues": [
        {
          "id": "STORY_D06_MANAGEMENT_001",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "안녕. 예고한 대로 보안 재평가하러 왔어. 예약 손님은 문 열어 주는 거지?",
          "emotion_direction": "여유",
          "portrait_emotion": "teasing",
          "source_line": 413
        },
        {
          "id": "STORY_D06_MANAGEMENT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "침입 예약은 예약이 아니다. 범행 예고다.",
          "emotion_direction": "단호",
          "portrait_emotion": "serious",
          "source_line": 414
        },
        {
          "id": "STORY_D06_MANAGEMENT_003",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "말은 그렇게 하면서 내 쪽지는 잘 보관했네. 설마 기다렸어?",
          "emotion_direction": "장난",
          "portrait_emotion": "teasing",
          "source_line": 415
        },
        {
          "id": "STORY_D06_MANAGEMENT_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "증거물로 보관한 거다. 왕좌 서랍 가장 안쪽에.",
          "emotion_direction": "당황",
          "portrait_emotion": "flustered",
          "source_line": 416
        },
        {
          "id": "STORY_D06_MANAGEMENT_005",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "마왕님, 숨긴 위치까지 설명하실 필요는 없었습니다.",
          "emotion_direction": "건조",
          "portrait_emotion": "dry",
          "source_line": 417
        },
        {
          "id": "STORY_D06_MANAGEMENT_006",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "오늘의 평점은 중요하지 않습니다. 금화가 한 닢이라도 줄면 제 두개골 광택이 사라집니다.",
          "emotion_direction": "긴장",
          "portrait_emotion": "panic",
          "source_line": 418
        },
        {
          "id": "STORY_D06_MANAGEMENT_007",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "해골이 안색 걱정하는 건 처음 보네.",
          "emotion_direction": "웃음",
          "portrait_emotion": "teasing",
          "source_line": 419
        },
        {
          "id": "STORY_D06_MANAGEMENT_008",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "금고 잔액이 제 안색입니다.",
          "emotion_direction": "진지",
          "portrait_emotion": "accounting",
          "source_line": 420
        },
        {
          "id": "STORY_D06_MANAGEMENT_009",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "보급 상자에 도장 찍은 게 너희였지? 도둑 한 명이 더 따라왔어. 홍보 효과 확실하네.",
          "emotion_direction": "웃음",
          "portrait_emotion": "teasing",
          "source_line": 468
        },
        {
          "id": "STORY_D06_MANAGEMENT_010",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "광고를 했더니 고객이 아니라 도둑이 늘었군.",
          "emotion_direction": "당황",
          "portrait_emotion": "flustered",
          "source_line": 469
        },
        {
          "id": "STORY_D06_MANAGEMENT_011",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "마케팅 부서를 없애고 싶지만 아직 만든 적도 없습니다.",
          "emotion_direction": "한숨",
          "portrait_emotion": "accounting",
          "source_line": 470
        }
      ]
    },
    {
      "id": "STORY_D06_PRECOMBAT",
      "day": 6,
      "title": "DAY 6 · 전투 직전",
      "trigger": "precombat_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "전투 직전"
      },
      "cues": [
        {
          "id": "STORY_D06_PRECOMBAT_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "탐험가가 주 경로를 열고, 니아와 도둑들이 보물 보관실로 파고듭니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 424
        },
        {
          "id": "STORY_D06_PRECOMBAT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "푸딩은 전선을 붙잡고, 곱은 빠지는 도둑을 쫓아라. 핀은 뒤에서 빈틈을 태워라.",
          "emotion_direction": "지휘",
          "portrait_emotion": "command",
          "source_line": 425
        },
        {
          "id": "STORY_D06_PRECOMBAT_003",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "빈틈도 타? 그럼 다 타기 전에 곱이 때린다!",
          "emotion_direction": "의욕",
          "portrait_emotion": "eager",
          "source_line": 426
        },
        {
          "id": "STORY_D06_PRECOMBAT_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "내 화염구와 경쟁하지 마. 지난번엔 네 앞머리만 졌어.",
          "emotion_direction": "시큰둥",
          "portrait_emotion": "proud",
          "source_line": 427
        },
        {
          "id": "STORY_D06_PRECOMBAT_005",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "오늘은 괜찮다. 원래 짧아서 티 안 난다.",
          "emotion_direction": "머리 확인",
          "portrait_emotion": "eager",
          "source_line": 428
        },
        {
          "id": "STORY_D06_PRECOMBAT_006",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "니아는 우리랑 계속 싸우러 오는 거야?",
          "emotion_direction": "걱정",
          "portrait_emotion": "happy",
          "source_line": 429
        },
        {
          "id": "STORY_D06_PRECOMBAT_007",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "아직은 적이다. 하지만 적도 계속 얼굴을 보면 이름부터 부르게 되는 법이지.",
          "emotion_direction": "고민",
          "portrait_emotion": "serious",
          "source_line": 430
        },
        {
          "id": "STORY_D06_PRECOMBAT_008",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "감동적인데? 그럼 내 이름 부르면서 금고 열쇠도 던져 줘!",
          "emotion_direction": "멀리서",
          "portrait_emotion": "teasing",
          "source_line": 431
        }
      ]
    },
    {
      "id": "STORY_D06_COMBAT_01",
      "day": 6,
      "title": "DAY 6 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 0
      },
      "cues": [
        {
          "id": "STORY_D06_COMBAT_01_001",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "탐험가들이 앞을 열었네. 그럼 난 늘 하던 대로 비싼 쪽으로 갈게.",
          "emotion_direction": "집중",
          "portrait_emotion": "focused",
          "source_line": 435
        },
        {
          "id": "STORY_D06_COMBAT_01_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "늘 하던 대로라니! 두 번째 방문으로 단골인 척하지 마라!",
          "emotion_direction": "발끈",
          "portrait_emotion": "offended",
          "source_line": 436
        },
        {
          "id": "STORY_D06_COMBAT_01_003",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "단골 할인은 없습니다! 오히려 재침입 할증이 붙습니다!",
          "emotion_direction": "절박",
          "portrait_emotion": "panic",
          "source_line": 437
        },
        {
          "id": "STORY_D06_COMBAT_01_004",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "잡히면 계산할게. 안 잡히면 내가 계산한 만큼 가져가고.",
          "emotion_direction": "장난",
          "portrait_emotion": "teasing",
          "source_line": 438
        }
      ]
    },
    {
      "id": "STORY_D06_COMBAT_02",
      "day": 6,
      "title": "DAY 6 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 10
      },
      "cues": [
        {
          "id": "STORY_D06_COMBAT_02_001",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "잡았다! 아니, 거의 잡았다! 아니, 지금부터 잡는다!",
          "emotion_direction": "추격",
          "portrait_emotion": "eager",
          "source_line": 439
        },
        {
          "id": "STORY_D06_COMBAT_02_002",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "진행 상황을 실시간으로 보고하지 말고 발부터 움직여.",
          "emotion_direction": "놀림",
          "portrait_emotion": "proud",
          "source_line": 440
        },
        {
          "id": "STORY_D06_COMBAT_02_003",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "전보다 동선이 좋아졌네. 너희, 정말 배우고 있구나.",
          "emotion_direction": "조금 놀람",
          "portrait_emotion": "surprised",
          "source_line": 441
        },
        {
          "id": "STORY_D06_COMBAT_02_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "네가 자꾸 시험하러 오니까 말이지. 다음엔 만점 받을 준비를 해라.",
          "emotion_direction": "진심 섞인 자랑",
          "portrait_emotion": "proud",
          "source_line": 442
        }
      ]
    },
    {
      "id": "STORY_D06_RESULT_WIN",
      "day": 6,
      "title": "DAY 6 · 승리 결산",
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "승리 결산"
      },
      "cues": [
        {
          "id": "STORY_D06_RESULT_WIN_001",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "점수는 문보다 움직임을 더 많이 볼 거야. 실제로 뭘 지켰는지도 포함해서.",
          "emotion_direction": "평가",
          "portrait_emotion": "teasing",
          "source_line": 446
        },
        {
          "id": "STORY_D06_RESULT_WIN_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "드디어 내 마왕성이 도둑에게 교육 기관으로 인정받았군.",
          "emotion_direction": "우쭐",
          "portrait_emotion": "serious",
          "source_line": 447
        },
        {
          "id": "STORY_D06_RESULT_WIN_003",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "교육비 대신 시설 수리비가 나왔습니다.",
          "emotion_direction": "무심",
          "portrait_emotion": "dry",
          "source_line": 448
        },
        {
          "id": "STORY_D06_RESULT_WIN_004",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "이번엔 빈손이네. 지난번보다 점수를 꽤 올려 줘야겠어.",
          "emotion_direction": "인정",
          "portrait_emotion": "teasing",
          "source_line": 453,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": false
              }
            ]
          }
        },
        {
          "id": "STORY_D06_RESULT_WIN_005",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "보물 잔액 확인 완료. 제 안색이 돌아왔습니다.",
          "emotion_direction": "안도",
          "portrait_emotion": "relieved",
          "source_line": 454,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": false
              }
            ]
          }
        },
        {
          "id": "STORY_D06_RESULT_WIN_006",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "뼈 색은 아까랑 똑같아.",
          "emotion_direction": "빈정",
          "portrait_emotion": "proud",
          "source_line": 455,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": false
              }
            ]
          }
        },
        {
          "id": "STORY_D06_RESULT_WIN_007",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "몇 닢은 챙겼네. 추격은 빨라졌는데 금고 문은 아직 솔직해.",
          "emotion_direction": "장난",
          "portrait_emotion": "teasing",
          "source_line": 457,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D06_RESULT_WIN_008",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "잔액이 줄었습니다. 제 안색도 함께 빠졌습니다.",
          "emotion_direction": "침통",
          "portrait_emotion": "accounting",
          "source_line": 458,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D06_RESULT_WIN_009",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "뼈가 조금 더 창백해진 것 같긴 해.",
          "emotion_direction": "위로하는 척",
          "portrait_emotion": "proud",
          "source_line": 459,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D06_RESULT_WIN_010",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "회계 담당자에게만 보이는 안색이 있습니다.",
          "emotion_direction": "엄숙",
          "portrait_emotion": "accounting",
          "source_line": 461,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D06_RESULT_WIN_011",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "시설은 좀 손봐. 다음번엔 나 말고 더 무식하게 밀고 들어오는 애들이 올 테니까.",
          "emotion_direction": "떠나며 부드러움",
          "portrait_emotion": "teasing",
          "source_line": 462,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D06_RESULT_WIN_012",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "니아의 지적이 맞습니다. 내일 시설 하나를 지금보다 튼튼하게 만드는 상담을 진행하겠습니다.",
          "emotion_direction": "예고",
          "portrait_emotion": "stern",
          "source_line": 463,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        }
      ]
    }
  ]
}
