          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "첫 번째, 간다. 이건 예고편이야!",
          "emotion_direction": "신남",
          "portrait_emotion": "teasing",
          "source_line": 1307
        },
        {
          "id": "STORY_D17_COMBAT_01_002",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "예고편부터 상영 중지다!",
          "emotion_direction": "맹렬함",
          "portrait_emotion": "eager",
          "source_line": 1308
        },
        {
          "id": "STORY_D17_COMBAT_01_003",
          "speaker_id": "NARRATOR",
          "speaker_label": "첫 도둑",
          "text_ko": "잠깐, 왜 고블린이 입구가 아니라 여기서 기다려?",
          "emotion_direction": "당황",
          "portrait_emotion": "none",
          "source_line": 1309
        },
        {
          "id": "STORY_D17_COMBAT_01_004",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "길을 미리 봤으니까.",
          "emotion_direction": "자랑",
          "portrait_emotion": "mischief",
          "source_line": 1310
        }
      ]
    },
    {
      "id": "STORY_D17_COMBAT_02",
      "day": 17,
      "title": "DAY 17 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 10
      },
      "cues": [
        {
          "id": "STORY_D17_COMBAT_02_001",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "첫 침입 막았다. 아직 자리를 풀지 마!",
          "emotion_direction": "집중",
          "portrait_emotion": "serious",
          "source_line": 1311
        },
        {
          "id": "STORY_D17_COMBAT_02_002",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "방어 병력 재배치 확인. 두 번째 침투 가능 경로를 기록합니다.",
          "emotion_direction": "냉정함",
          "portrait_emotion": "stern",
          "source_line": 1312
        },
        {
          "id": "STORY_D17_COMBAT_02_003",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "남의 시험 중에 답안 훔쳐보지 마.",
          "emotion_direction": "못마땅",
          "portrait_emotion": "proud",
          "source_line": 1313
        },
        {
          "id": "STORY_D17_COMBAT_02_004",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "조사관은 여기서 막을게요! 곱은 뒤를 계속 봐요!",
          "emotion_direction": "버팀",
          "portrait_emotion": "happy",
          "source_line": 1314
        }
      ]
    },
    {
      "id": "STORY_D17_COMBAT_03",
      "day": 17,
      "title": "DAY 17 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
