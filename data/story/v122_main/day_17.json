      },
      "cues": [
        {
          "id": "STORY_D17_COMBAT_03_001",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "두 번째 발소리, 들리나?",
          "emotion_direction": "낮은 웃음",
          "portrait_emotion": "teasing",
          "source_line": 1315
        },
        {
          "id": "STORY_D17_COMBAT_03_002",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "들려. 첫 번째보다 발이 무겁네!",
          "emotion_direction": "씩 웃음",
          "portrait_emotion": "eager",
          "source_line": 1316
        },
        {
          "id": "STORY_D17_COMBAT_03_003",
          "speaker_id": "NARRATOR",
          "speaker_label": "두 번째 도둑",
          "text_ko": "발소리만 듣고 어떻게 알아?",
          "emotion_direction": "황당",
          "portrait_emotion": "none",
          "source_line": 1317
        },
        {
          "id": "STORY_D17_COMBAT_03_004",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "너희가 금화를 생각하면 걸음이 빨라지거든!",
          "emotion_direction": "자신만만",
          "portrait_emotion": "eager",
          "source_line": 1318
        }
      ]
    },
    {
      "id": "STORY_D17_RESULT_WIN",
      "day": 17,
      "title": "DAY 17 · 승리 결산",
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "승리 결산"
      },
      "cues": [
        {
          "id": "STORY_D17_RESULT_WIN_001",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "두 차례가 다 끝날 때까지 긴장을 놓지 않은 건 제법이야.",
          "emotion_direction": "감탄",
          "portrait_emotion": "teasing",
          "source_line": 1322
        },
        {
          "id": "STORY_D17_RESULT_WIN_002",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "그래서 등급은 무엇입니까?",
          "emotion_direction": "초조",
          "portrait_emotion": "accounting",
          "source_line": 1323
        },
        {
          "id": "STORY_D17_RESULT_WIN_003",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "문 상태, 추격 속도, 실제 손실을 다 보고 정해야지.",
          "emotion_direction": "뜸 들임",
          "portrait_emotion": "teasing",
          "source_line": 1324
        },
        {
          "id": "STORY_D17_RESULT_WIN_004",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "둘 다 빈손이야. 이번 성적표는 골딘도 펼쳐 볼 만하겠네.",
          "emotion_direction": "인정",
          "portrait_emotion": "teasing",
          "source_line": 1329,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": false
              }
            ]
          }
        },
        {
          "id": "STORY_D17_RESULT_WIN_005",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "끝까지 쫓긴 했지만 빈손은 아니야. 놓친 차례가 어디였는지 성적표에 적어 둘게.",
          "emotion_direction": "평가",
          "portrait_emotion": "teasing",
          "source_line": 1331,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D17_RESULT_WIN_006",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "도둑에게 성적표를 기다리는 날이 올 줄은 몰랐습니다.",
          "emotion_direction": "고통",
          "portrait_emotion": "accounting",
          "source_line": 1333,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D17_RESULT_WIN_007",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "낮게 나오면 학부모 상담도 해?",
          "emotion_direction": "장난기",
          "portrait_emotion": "proud",
          "source_line": 1334,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D17_RESULT_WIN_008",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "학부모가 누구인데.",
          "emotion_direction": "한숨",
          "portrait_emotion": "serious",
          "source_line": 1335,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D17_RESULT_WIN_009",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "왕좌에 앉아 있는 사람?",
          "emotion_direction": "마왕을 봄",
          "portrait_emotion": "proud",
          "source_line": 1336,
          "conditions": {
            "all": [
              {
                "fact": "treasure_damaged",
                "op": "eq",
                "value": true
              }
            ]
          }
        },
        {
          "id": "STORY_D17_RESULT_WIN_010",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "마왕님, 저희 보호자였어요?",
          "emotion_direction": "웃음",
          "portrait_emotion": "happy",
          "source_line": 1337,
          "conditions": {
