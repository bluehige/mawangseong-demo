  "scenes": [
    {
      "id": "STORY_D17_MANAGEMENT",
      "day": 17,
      "title": "DAY 17 · 관리 대화",
      "trigger": "management_entered",
      "delivery": "blocking",
      "repeat_policy": "once_first_cycle_day",
      "metadata": {
        "title": "관리 대화"
      },
      "cues": [
        {
          "id": "STORY_D17_MANAGEMENT_001",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "좋은 아침, 마왕성 보안 담당 여러분.",
          "emotion_direction": "장난기",
          "portrait_emotion": "teasing",
          "source_line": 1277
        },
        {
          "id": "STORY_D17_MANAGEMENT_002",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "보안 담당은 저희고, 당신은 보안 사고입니다.",
          "emotion_direction": "싸늘함",
          "portrait_emotion": "accounting",
          "source_line": 1278
        },
        {
          "id": "STORY_D17_MANAGEMENT_003",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "사고가 직접 개선안을 들고 왔으면 상담비를 받아야 하지 않을까?",
          "emotion_direction": "능청",
          "portrait_emotion": "teasing",
          "source_line": 1279
        },
        {
          "id": "STORY_D17_MANAGEMENT_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "오늘은 뭘 훔치려고?",
          "emotion_direction": "경계",
          "portrait_emotion": "serious",
          "source_line": 1280
        },
        {
          "id": "STORY_D17_MANAGEMENT_005",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "한 번으로 끝내지 않을 거야. 첫 번째를 막고 안심하는 순간 두 번째가 들어갈 거거든.",
          "emotion_direction": "미소",
          "portrait_emotion": "teasing",
          "source_line": 1281
        },
        {
          "id": "STORY_D17_MANAGEMENT_006",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "좋아. 두 번 다 잡으면 되는 거네.",
          "emotion_direction": "의욕",
          "portrait_emotion": "eager",
          "source_line": 1282
        },
        {
          "id": "STORY_D17_MANAGEMENT_007",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "숫자가 둘까지라 이해가 빠르네.",
          "emotion_direction": "빈정거림",
          "portrait_emotion": "proud",
          "source_line": 1283
        },
        {
          "id": "STORY_D17_MANAGEMENT_008",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "나도 셋까지는 알아!",
          "emotion_direction": "발끈",
          "portrait_emotion": "eager",
          "source_line": 1284
        },
        {
          "id": "STORY_D17_MANAGEMENT_009",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "첫 번째 침입 뒤에도 자리를 풀면 안 된다는 뜻이죠?",
          "emotion_direction": "진지함",
          "portrait_emotion": "happy",
          "source_line": 1285
        },
        {
          "id": "STORY_D17_MANAGEMENT_010",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "맞습니다. 도둑 하나를 막고 한숨 돌릴 때쯤 두 번째가 들어옵니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 1286
        },
        {
          "id": "STORY_D17_MANAGEMENT_011",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "한 번 막았다고 축하하지 마십시오. 오늘 금고는 두 번 살아남아야 합니다.",
          "emotion_direction": "장부를 안으며",
          "portrait_emotion": "accounting",
          "source_line": 1287
        },
        {
          "id": "STORY_D17_MANAGEMENT_012",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "둘 다 막으면 내가 직접 보안 등급을 매겨줄게.",
          "emotion_direction": "즐거움",
          "portrait_emotion": "teasing",
          "source_line": 1288
        }
      ]
    },
    {
      "id": "STORY_D17_PRECOMBAT",
      "day": 17,
      "title": "DAY 17 · 전투 직전",
      "trigger": "precombat_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "전투 직전"
      },
      "cues": [
        {
          "id": "STORY_D17_PRECOMBAT_001",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "도둑이 남의 금고에 등급을 매기는 게 정상인가?",
          "emotion_direction": "의심",
          "portrait_emotion": "serious",
          "source_line": 1292
        },
        {
          "id": "STORY_D17_PRECOMBAT_002",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "맛집 평가는 요리사가 아니라 손님이 하잖아.",
          "emotion_direction": "태연함",
          "portrait_emotion": "teasing",
          "source_line": 1293
        },
        {
          "id": "STORY_D17_PRECOMBAT_003",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "저희 금고는 식당이 아닙니다.",
          "emotion_direction": "분노 억제",
          "portrait_emotion": "accounting",
          "source_line": 1294
        },
        {
          "id": "STORY_D17_PRECOMBAT_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "자꾸 비워지긴 하니까 뷔페에 가깝지.",
          "emotion_direction": "장난기",
          "portrait_emotion": "proud",
          "source_line": 1295
        },
        {
          "id": "STORY_D17_PRECOMBAT_005",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "핀, 오늘 급료에서 불씨 한 개를 빼겠습니다.",
          "emotion_direction": "상처",
          "portrait_emotion": "accounting",
          "source_line": 1296
        },
        {
          "id": "STORY_D17_PRECOMBAT_006",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "보라색 후드만 보이면 따라간다. 첫 번째든 두 번째든 상관없어.",
          "emotion_direction": "자신감",
          "portrait_emotion": "eager",
          "source_line": 1297
        },
        {
          "id": "STORY_D17_PRECOMBAT_007",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "첫 침입 뒤에도 앞을 막고 있을게요. 곱이 돌아올 길은 제가 열어둘게요.",
          "emotion_direction": "다짐",
          "portrait_emotion": "brave",
          "source_line": 1298
        },
        {
          "id": "STORY_D17_PRECOMBAT_008",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "좋아. 이번에는 누구 혼자 금고를 지키는 시험이 아니야. 우리 교대가 제대로 되는지 보는 거다.",
          "emotion_direction": "따뜻함",
          "portrait_emotion": "soft",
          "source_line": 1299
        },
        {
          "id": "STORY_D17_PRECOMBAT_009",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "그 말은 마음에 드네. 좋은 금고는 문보다 사람이 먼저 움직이거든.",
          "emotion_direction": "조금 진지함",
          "portrait_emotion": "teasing",
          "source_line": 1300
        },
        {
          "id": "STORY_D17_PRECOMBAT_010",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "첫 도둑 앞에는 짧은 전열, 두 침투 사이에는 조사관이 들어옵니다.",
          "emotion_direction": "전술적",
          "portrait_emotion": "stern",
          "source_line": 1301
        },
        {
          "id": "STORY_D17_PRECOMBAT_011",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "첫 번째를 잡은 곱이 입구에서 싸움 구경을 시작하면 두 번째는 놓칩니다.",
          "emotion_direction": "경고",
          "portrait_emotion": "accounting",
          "source_line": 1302
        },
        {
          "id": "STORY_D17_PRECOMBAT_012",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "한 번 그랬다고 평생 말할 거야?",
          "emotion_direction": "억울함",
          "portrait_emotion": "eager",
          "source_line": 1303
        }
      ]
    },
    {
      "id": "STORY_D17_COMBAT_01",
