        {
          "id": "STORY_D18_COMBAT_02_002",
          "speaker_id": "NARRATOR",
          "speaker_label": "도둑",
          "text_ko": "왕국 도장은 속여도 우리 코는 못 속이지.",
          "emotion_direction": "비웃음",
          "portrait_emotion": "none",
          "source_line": 1406,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
