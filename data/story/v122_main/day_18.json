                "value": "d18_forged_manifest"
              }
            ]
          }
        },
        {
          "id": "STORY_D18_COMBAT_02_003",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "알아. 그래서 코보다 먼저 네 발목을 보고 있었어!",
          "emotion_direction": "맹렬함",
          "portrait_emotion": "eager",
          "source_line": 1407,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_forged_manifest"
              }
            ]
          }
        },
        {
          "id": "STORY_D18_COMBAT_02_004",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "도둑은 두 차례입니다. 첫 추격 뒤 위치를 다시 잡으십시오.",
          "emotion_direction": "전술적",
          "portrait_emotion": "stern",
          "source_line": 1408,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_forged_manifest"
              }
            ]
          }
        }
      ]
