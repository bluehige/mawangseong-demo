  "scenes": [
    {
      "id": "STORY_D18_MANAGEMENT",
      "day": 18,
      "title": "DAY 18 · 관리 대화",
      "trigger": "management_entered",
      "delivery": "blocking",
      "repeat_policy": "once_first_cycle_day",
      "metadata": {
        "title": "관리 대화"
      },
      "cues": [
        {
          "id": "STORY_D18_MANAGEMENT_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "왕국 봉쇄대가 세관 장부 길과 밀수 갱도를 동시에 조이고 있습니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 1362
        },
        {
          "id": "STORY_D18_MANAGEMENT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "둘 다 막으면 안 돼?",
          "emotion_direction": "곤란",
          "portrait_emotion": "serious",
          "source_line": 1363
        },
        {
          "id": "STORY_D18_MANAGEMENT_003",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "둘 다 건드리면 원정대가 돌아오지 못합니다.",
          "emotion_direction": "단호함",
          "portrait_emotion": "stern",
          "source_line": 1364
        },
        {
          "id": "STORY_D18_MANAGEMENT_004",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "가짜 장부를 흘리면 조사관은 빈 창고로 빠져. 대신 도둑 둘은 그대로 와.",
          "emotion_direction": "지도를 펼치며",
          "portrait_emotion": "mischief",
          "source_line": 1365
        },
        {
          "id": "STORY_D18_MANAGEMENT_005",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "갱도를 무너뜨리면 도둑 하나가 돌아가. 대신 왕국군이 빈자리에 방패병을 붙일 거야.",
          "emotion_direction": "설명",
          "portrait_emotion": "teasing",
          "source_line": 1366
        },
        {
          "id": "STORY_D18_MANAGEMENT_006",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "도둑 둘이냐, 방패 둘이냐.",
          "emotion_direction": "고민",
          "portrait_emotion": "eager",
          "source_line": 1367
        },
        {
          "id": "STORY_D18_MANAGEMENT_007",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "네가 둘까지 알아서 다행이네.",
          "emotion_direction": "시큰둥",
          "portrait_emotion": "proud",
          "source_line": 1368
        },
        {
          "id": "STORY_D18_MANAGEMENT_008",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "어제부터 왜 자꾸 숫자로 공격해!",
          "emotion_direction": "발끈",
          "portrait_emotion": "eager",
          "source_line": 1369
        },
        {
          "id": "STORY_D18_MANAGEMENT_009",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "도둑 둘은 보물 위험, 방패병 둘은 수리비 위험입니다. 어느 쪽도 제게는 나쁩니다.",
          "emotion_direction": "계산적",
          "portrait_emotion": "accounting",
          "source_line": 1370
        },
        {
          "id": "STORY_D18_MANAGEMENT_010",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "그래도 우리가 더 잘 막을 수 있는 쪽을 고를 수는 있어요.",
          "emotion_direction": "현실적",
          "portrait_emotion": "happy",
          "source_line": 1371
        },
        {
          "id": "STORY_D18_MANAGEMENT_011",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "네가 쓰던 갱도를 우리가 막아도 괜찮겠어?",
          "emotion_direction": "니아를 보며",
          "portrait_emotion": "serious",
          "source_line": 1372
        },
        {
          "id": "STORY_D18_MANAGEMENT_012",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "길은 또 찾으면 돼. 지금은 저 길을 왕국이 쓰는 게 더 싫어.",
          "emotion_direction": "담담한 척",
          "portrait_emotion": "teasing",
          "source_line": 1373
        }
      ]
    },
    {
      "id": "STORY_D18_PRECOMBAT",
      "day": 18,
      "title": "DAY 18 · 전투 직전",
      "trigger": "precombat_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "전투 직전"
      },
      "cues": [
        {
          "id": "STORY_D18_PRECOMBAT_001",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "좋아. 완벽하게 안전한 답은 없다. 우리가 감당할 수 있는 위협을 남긴다.",
          "emotion_direction": "결정",
          "portrait_emotion": "serious",
          "source_line": 1377
        },
        {
          "id": "STORY_D18_PRECOMBAT_002",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "우리가 어느 길을 끊느냐에 따라, 오늘 정문으로 몰려올 얼굴도 달라집니다.",
          "emotion_direction": "확인",
          "portrait_emotion": "stern",
          "source_line": 1378
        },
        {
          "id": "STORY_D18_PRECOMBAT_003",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "그리고 왕국은 우리가 건드린 흔적을 볼 거야. 내일 후속대 얼굴도 달라질 수 있어.",
          "emotion_direction": "진지함",
          "portrait_emotion": "mischief",
          "source_line": 1379
        },
        {
          "id": "STORY_D18_PRECOMBAT_004",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "선택 한 번이 이틀치 장부를 괴롭히는군요.",
          "emotion_direction": "한숨",
          "portrait_emotion": "accounting",
          "source_line": 1380
        },
        {
          "id": "STORY_D18_PRECOMBAT_005",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "조사관 도장은 베꼈는데 필체가 조금 이상해.",
          "emotion_direction": "긴장",
          "portrait_emotion": "flustered",
          "source_line": 1384,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_forged_manifest"
              }
            ]
          }
        },
        {
          "id": "STORY_D18_PRECOMBAT_006",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "얼마나?",
          "emotion_direction": "호기심",
          "portrait_emotion": "proud",
          "source_line": 1385,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_forged_manifest"
              }
            ]
          }
        },
        {
          "id": "STORY_D18_PRECOMBAT_007",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "‘왕국’의 ‘왕’이 문어처럼 생겼어.",
          "emotion_direction": "머쓱함",
          "portrait_emotion": "flustered",
          "source_line": 1386,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_forged_manifest"
              }
            ]
          }
        },
        {
          "id": "STORY_D18_PRECOMBAT_008",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "조사관은 글씨보다 도장을 믿어. 도둑 둘은 냄새를 믿고 그대로 올 거고.",
          "emotion_direction": "능청",
          "portrait_emotion": "teasing",
          "source_line": 1387,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_forged_manifest"
              }
            ]
          }
        },
        {
          "id": "STORY_D18_PRECOMBAT_009",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "갱도 입구에 ‘공사 중’ 팻말도 세워뒀어.",
          "emotion_direction": "먼지를 털며",
          "portrait_emotion": "eager",
          "source_line": 1391,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_seal_smuggling_tunnel"
              }
            ]
          }
        },
        {
          "id": "STORY_D18_PRECOMBAT_010",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "글자는 제대로 썼고?",
          "emotion_direction": "의심",
          "portrait_emotion": "proud",
          "source_line": 1392,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_seal_smuggling_tunnel"
              }
            ]
          }
        },
        {
          "id": "STORY_D18_PRECOMBAT_011",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "로로가 썼지.",
          "emotion_direction": "당당함",
          "portrait_emotion": "eager",
          "source_line": 1393,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_seal_smuggling_tunnel"
              }
            ]
          }
        },
        {
          "id": "STORY_D18_PRECOMBAT_012",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "갱도는 막혔고 후발 도둑은 돌아갔어. 대신 방패병 둘이 정문으로 온다.",
          "emotion_direction": "웃음",
          "portrait_emotion": "teasing",
          "source_line": 1394,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d18_seal_smuggling_tunnel"
              }
            ]
          }
        }
      ]
    },
    {
