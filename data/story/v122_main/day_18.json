        {
          "id": "STORY_D18_RESULT_WIN_006",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "갱도 위치까지 알려줘서 고마워요.",
          "emotion_direction": "니아에게",
          "portrait_emotion": "happy",
          "source_line": 1424
        },
        {
          "id": "STORY_D18_RESULT_WIN_007",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "감사는 됐어. 나도 왕국이 내 길을 자기들 것처럼 쓰는 꼴이 싫었을 뿐이야.",
          "emotion_direction": "어색함",
          "portrait_emotion": "teasing",
          "source_line": 1425
        },
        {
          "id": "STORY_D18_RESULT_WIN_008",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "이유가 뭐든 오늘은 네 정보 덕분에 지켰어. 그건 기억할게.",
          "emotion_direction": "진심",
          "portrait_emotion": "serious",
          "source_line": 1426
        },
        {
          "id": "STORY_D18_RESULT_WIN_009",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "마음대로 해. 대신 보안 등급에 가산점은 없어.",
          "emotion_direction": "조금 누그러짐",
          "portrait_emotion": "teasing",
          "source_line": 1427
        },
        {
          "id": "STORY_D18_RESULT_WIN_010",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "우리 편이 돼도 깐깐하네.",
          "emotion_direction": "장난기",
          "portrait_emotion": "eager",
          "source_line": 1428
        },
        {
          "id": "STORY_D18_RESULT_WIN_011",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "봉쇄대가 후퇴하면서 명령서 하나를 잃어버렸어. 문제는 원본을 우리가 주웠다는 거야.",
          "emotion_direction": "경계",
          "portrait_emotion": "mischief",
          "source_line": 1429
