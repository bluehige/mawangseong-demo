        {
          "id": "STORY_D18_COMBAT_01_001",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "어느 쪽을 골라도 앞은 막을게요!",
          "emotion_direction": "집중",
          "portrait_emotion": "happy",
          "source_line": 1398
        },
        {
          "id": "STORY_D18_COMBAT_01_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "숫자보다 역할을 봐! 오늘 우리가 남긴 위협이 뭔지 기억해!",
          "emotion_direction": "명령",
          "portrait_emotion": "command",
          "source_line": 1399
        },
        {
          "id": "STORY_D18_COMBAT_01_003",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "그리고 보물 방도 기억해 주십시오!",
          "emotion_direction": "초조",
          "portrait_emotion": "accounting",
          "source_line": 1400
        },
        {
          "id": "STORY_D18_COMBAT_01_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "골딘은 죽어서도 금고 유령이 되겠네.",
          "emotion_direction": "빈정거림",
          "portrait_emotion": "proud",
          "source_line": 1401
        }
      ]
    },
    {
      "id": "STORY_D18_COMBAT_02",
