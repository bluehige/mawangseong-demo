    {
      "id": "STORY_D18_RESULT_WIN",
      "day": 18,
      "title": "DAY 18 · 승리 결산",
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "승리 결산"
      },
      "cues": [
        {
          "id": "STORY_D18_RESULT_WIN_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "선택한 적 역할에 맞춰 수비 조합을 바꾸며 봉쇄선을 돌파했습니다.",
          "emotion_direction": "평가",
          "portrait_emotion": "stern",
          "source_line": 1419
        },
        {
          "id": "STORY_D18_RESULT_WIN_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "적을 줄이는 것보다 어떤 적을 남길지 고르는 게 더 어렵네.",
          "emotion_direction": "피곤함",
          "portrait_emotion": "serious",
          "source_line": 1420
        },
        {
          "id": "STORY_D18_RESULT_WIN_003",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "그걸 알면 이제 초보는 아니지. 도둑도 항상 제일 비싼 물건만 훔치진 않거든.",
          "emotion_direction": "인정",
          "portrait_emotion": "teasing",
          "source_line": 1421
        },
        {
          "id": "STORY_D18_RESULT_WIN_004",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "그렇다면 앞으로는 아무것도 훔치지 않는 선택을 권합니다.",
          "emotion_direction": "날카로움",
          "portrait_emotion": "accounting",
          "source_line": 1422
        },
        {
          "id": "STORY_D18_RESULT_WIN_005",
          "speaker_id": "CHR_THIEF_NIA",
          "speaker_label": "니아",
          "text_ko": "그건 직업 정체성이 흔들려서 안 돼.",
          "emotion_direction": "능청",
          "portrait_emotion": "teasing",
          "source_line": 1423
