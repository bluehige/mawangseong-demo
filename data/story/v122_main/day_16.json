      "cues": [
        {
          "id": "STORY_D16_COMBAT_01_001",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "성이 커지니까 통로가 넓어졌는데, 적도 더 당당하게 들어오네요!",
          "emotion_direction": "집중",
          "portrait_emotion": "happy",
          "source_line": 1217
        },
        {
          "id": "STORY_D16_COMBAT_01_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "성이 커졌으니 손님도 격식 있게 쫓아내야지.",
          "emotion_direction": "허세",
          "portrait_emotion": "proud",
          "source_line": 1218
        },
        {
          "id": "STORY_D16_COMBAT_01_003",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "불에 격식이 필요한가?",
          "emotion_direction": "빈정거림",
          "portrait_emotion": "proud",
          "source_line": 1219
        },
        {
          "id": "STORY_D16_COMBAT_01_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "뜨겁게 예의를 갖춰.",
          "emotion_direction": "즉답",
          "portrait_emotion": "serious",
          "source_line": 1220
        }
      ]
    },
    {
      "id": "STORY_D16_COMBAT_02",
      "day": 16,
      "title": "DAY 16 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
