      },
      "cues": [
        {
          "id": "STORY_D16_COMBAT_03_001",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "조사관이 없는 동안 기록할 흔적도 태워둘게.",
          "emotion_direction": "여유",
          "portrait_emotion": "proud",
          "source_line": 1228,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d16_route_recon"
