    {
      "id": "STORY_D16_RESULT_WIN",
      "day": 16,
      "title": "DAY 16 · 승리 결산",
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "승리 결산"
      },
      "cues": [
        {
          "id": "STORY_D16_RESULT_WIN_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "우리가 먼저 길을 건드리니, 놈들도 우리가 고른 모양으로 왔군요.",
          "emotion_direction": "평가",
          "portrait_emotion": "stern",
          "source_line": 1240
