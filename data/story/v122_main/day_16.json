          }
        },
        {
          "id": "STORY_D16_COMBAT_03_002",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "로로의 지도대로군요. 빈길로 빠진 조사관은 잊고, 눈앞의 경계대만 밀어내십시오.",
          "emotion_direction": "차분함",
          "portrait_emotion": "stern",
          "source_line": 1229,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d16_route_recon"
              }
            ]
          }
        },
        {
          "id": "STORY_D16_COMBAT_03_003",
          "speaker_id": "NARRATOR",
          "speaker_label": "도둑",
          "text_ko": "수레를 그렇게 요란하게 몰고 가면 누가 못 따라가!",
          "emotion_direction": "숨 가쁨",
          "portrait_emotion": "none",
          "source_line": 1233,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d16_supply_ambush"
              }
            ]
          }
        },
        {
          "id": "STORY_D16_COMBAT_03_004",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "추격 비용은 귀하의 급여에서 공제하겠습니다.",
          "emotion_direction": "못마땅",
          "portrait_emotion": "accounting",
          "source_line": 1234,
          "conditions": {
