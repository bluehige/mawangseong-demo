      "cues": [
        {
          "id": "STORY_D16_COMBAT_02_001",
          "speaker_id": "NARRATOR",
          "speaker_label": "방패병",
          "text_ko": "보급로 경계대, 전열 유지!",
          "emotion_direction": "기합",
          "portrait_emotion": "none",
          "source_line": 1221
        },
        {
          "id": "STORY_D16_COMBAT_02_002",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "오늘은 네 뒤에 뭐가 오는지 이미 다 알아!",
          "emotion_direction": "웃음",
          "portrait_emotion": "eager",
          "source_line": 1222
        },
        {
          "id": "STORY_D16_COMBAT_02_003",
          "speaker_id": "CHR_ROLO",
          "speaker_label": "로로",
          "text_ko": "예상보다도 늦어. 우리가 먼저 길을 읽으니까 전투가 이렇게 달라지는구나.",
          "emotion_direction": "기쁨",
          "portrait_emotion": "mischief",
          "source_line": 1226,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d16_route_recon"
              }
            ]
          }
        },
        {
          "id": "STORY_D16_COMBAT_02_004",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "잘 봤어, 로로. 오늘 전선은 네 지도가 먼저 막은 거야.",
          "emotion_direction": "신뢰",
          "portrait_emotion": "serious",
          "source_line": 1227,
          "conditions": {
            "all": [
              {
                "fact": "completed_raid_ids",
                "op": "contains",
                "value": "d16_route_recon"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "STORY_D16_COMBAT_03",
      "day": 16,
      "title": "DAY 16 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
