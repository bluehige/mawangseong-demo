{
  "schema_version": 1,
  "day": 21,
  "scenes": [
    {
      "id": "STORY_D21_MANAGEMENT",
      "day": 21,
      "title": "DAY 21 · 관리 대화",
      "trigger": "management_entered",
      "delivery": "blocking",
      "repeat_policy": "once_first_cycle_day",
      "metadata": {
        "title": "관리 대화"
      },
      "cues": [
        {
          "id": "STORY_D21_MANAGEMENT_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "어젯밤 로만의 공병대는 물러났습니다. 다만 오늘 침입 명단 맨 위에 익숙한 이름이 있군요.",
          "emotion_direction": "긴장",
          "portrait_emotion": "stern",
          "source_line": 1618
        },
        {
          "id": "STORY_D21_MANAGEMENT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "설마 로만이 장부 들고 직접 오는 건 아니지?",
          "emotion_direction": "경계",
          "portrait_emotion": "serious",
          "source_line": 1619
        },
        {
          "id": "STORY_D21_MANAGEMENT_003",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "그자가 장부까지 들고 오면 전투가 아니라 합동 감사입니다. 차라리 칼이 낫습니다.",
          "emotion_direction": "질색",
          "portrait_emotion": "accounting",
          "source_line": 1620
        },
        {
          "id": "STORY_D21_MANAGEMENT_004",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "셀렌입니다. 이번에는 심사관이 아니라 현장 지휘관으로 등록됐습니다.",
          "emotion_direction": "담담",
          "portrait_emotion": "dry",
          "source_line": 1621
        },
        {
          "id": "STORY_D21_MANAGEMENT_005",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "공병이 멈춘 시간보다 마왕군이 목표를 바꾸는 시간이 더 짧았습니다. 오늘은 그 틈을 제가 직접 지휘하겠습니다.",
          "emotion_direction": "냉정",
          "portrait_emotion": "formal",
          "source_line": 1622
        },
        {
          "id": "STORY_D21_MANAGEMENT_006",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "지휘관 하나 잡으면 다 느려진다는 거지? 그럼 답 나왔네. 내가 달려가서 잡을게.",
          "emotion_direction": "의욕",
          "portrait_emotion": "eager",
          "source_line": 1623
        },
        {
          "id": "STORY_D21_MANAGEMENT_007",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "너 달려가면 앞은 누가 막아?",
          "emotion_direction": "걱정",
          "portrait_emotion": "happy",
          "source_line": 1624
        },
        {
          "id": "STORY_D21_MANAGEMENT_008",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "돌아오면서 막지.",
          "emotion_direction": "당당",
          "portrait_emotion": "eager",
          "source_line": 1625
        },
        {
          "id": "STORY_D21_MANAGEMENT_009",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "아주 빠른 무계획이네.",
          "emotion_direction": "건조",
          "portrait_emotion": "proud",
          "source_line": 1626
        },
        {
          "id": "STORY_D21_MANAGEMENT_010",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "셀렌이 살아 있는 동안 왕국군의 이동과 공격이 빨라집니다. 곱의 계획은 위험하지만 틀린 답은 아닙니다.",
          "emotion_direction": "설명",
          "portrait_emotion": "tutorial",
          "source_line": 1627
        },
        {
          "id": "STORY_D21_MANAGEMENT_011",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "전열을 지킬지, 셀렌부터 끊을지 정해야겠군.",
          "emotion_direction": "고민",
          "portrait_emotion": "serious",
          "source_line": 1628
        },
        {
          "id": "STORY_D21_MANAGEMENT_012",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "빠른 적에게 맞으면 수리비도 빠르게 쌓입니까?",
          "emotion_direction": "계산",
          "portrait_emotion": "accounting",
          "source_line": 1629
        },
        {
          "id": "STORY_D21_MANAGEMENT_013",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "청구 속도는 원래도 최상급입니다.",
          "emotion_direction": "무표정",
          "portrait_emotion": "stern",
          "source_line": 1630
        },
        {
          "id": "STORY_D21_MANAGEMENT_014",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "청구 속도만큼은 벌써 대마왕성급이군요.",
          "emotion_direction": "한숨",
          "portrait_emotion": "accounting",
          "source_line": 1631
        }
      ]
    },
    {
      "id": "STORY_D21_PRECOMBAT",
      "day": 21,
      "title": "DAY 21 · 전투 직전",
      "trigger": "precombat_confirmed",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "전투 직전"
      },
      "cues": [
        {
          "id": "STORY_D21_PRECOMBAT_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "선발 탐험가가 먼저 들어옵니다. 셀렌은 그 뒤를 따라 진입합니다.",
          "emotion_direction": "집중",
          "portrait_emotion": "stern",
          "source_line": 1635
        },
        {
          "id": "STORY_D21_PRECOMBAT_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "처음부터 전부 쏟지 마. 셀렌이 보일 때 추격할 힘을 남겨.",
          "emotion_direction": "지시",
          "portrait_emotion": "serious",
          "source_line": 1636
        },
        {
          "id": "STORY_D21_PRECOMBAT_003",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "알았어. 지금은 반만 신나 있을게.",
          "emotion_direction": "씩씩",
          "portrait_emotion": "eager",
          "source_line": 1637
        },
        {
          "id": "STORY_D21_PRECOMBAT_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "평소의 반이면 남들 전력 질주야.",
          "emotion_direction": "핀잔",
          "portrait_emotion": "proud",
          "source_line": 1638
        },
        {
          "id": "STORY_D21_PRECOMBAT_005",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "앞은 내가 붙잡을게. 곱이 지나갈 틈은 내가 열어 줄게.",
          "emotion_direction": "진지",
          "portrait_emotion": "happy",
          "source_line": 1639
        },
        {
          "id": "STORY_D21_PRECOMBAT_006",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "네가 먼저 그렇게 말해 주는 건 처음인데.",
          "emotion_direction": "놀람",
          "portrait_emotion": "eager",
          "source_line": 1640
        },
        {
          "id": "STORY_D21_PRECOMBAT_007",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "네가 돌아온다는 말도 오늘은 믿어 볼게.",
          "emotion_direction": "미소",
          "portrait_emotion": "happy",
          "source_line": 1641
        },
        {
          "id": "STORY_D21_PRECOMBAT_008",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "선발대, 마왕군 전열을 붙잡아라. 내가 들어가는 순간부터 속도를 올린다.",
          "emotion_direction": "단호",
          "portrait_emotion": "formal",
          "source_line": 1642
        },
        {
          "id": "STORY_D21_PRECOMBAT_009",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "남의 등을 밀어야만 빨라지는 군대라니, 지휘관이 꽤 바쁘겠어.",
          "emotion_direction": "도발",
          "portrait_emotion": "serious",
          "source_line": 1643
        },
        {
          "id": "STORY_D21_PRECOMBAT_010",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "각자 마음대로 뛰다가 문에 끼는 군대보다는 낫습니다.",
          "emotion_direction": "냉소",
          "portrait_emotion": "formal",
          "source_line": 1644
        },
        {
          "id": "STORY_D21_PRECOMBAT_011",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "그건 딱 한 번이었거든!",
          "emotion_direction": "억울",
          "portrait_emotion": "eager",
          "source_line": 1645
        },
        {
          "id": "STORY_D21_PRECOMBAT_012",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "세 번.",
          "emotion_direction": "정정",
          "portrait_emotion": "proud",
          "source_line": 1646
        },
        {
          "id": "STORY_D21_PRECOMBAT_013",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "추억 정리는 전투 뒤에 하십시오. 셀렌이 거의 도착했습니다.",
          "emotion_direction": "재촉",
          "portrait_emotion": "stern",
          "source_line": 1647
        }
      ]
    },
    {
      "id": "STORY_D21_COMBAT_01",
      "day": 21,
      "title": "DAY 21 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 0
      },
      "cues": [
        {
          "id": "STORY_D21_COMBAT_01_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "셀렌의 지휘 표식이 켜졌습니다. 왕국군 전체 속도가 상승합니다.",
          "emotion_direction": "경고",
          "portrait_emotion": "stern",
          "source_line": 1651
        },
        {
          "id": "STORY_D21_COMBAT_01_002",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "방패대는 전열 고정. 탐험대는 빈 갈래로 진군.",
          "emotion_direction": "지휘",
          "portrait_emotion": "formal",
          "source_line": 1652
        },
        {
          "id": "STORY_D21_COMBAT_01_003",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "곱, 셀렌을 물어. 푸딩은 방패병을 붙잡고, 핀은 방패 뒤를 쏴.",
          "emotion_direction": "명령",
          "portrait_emotion": "command",
          "source_line": 1653
        },
        {
          "id": "STORY_D21_COMBAT_01_004",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "드디어 전부 신나도 되는 시간이네!",
          "emotion_direction": "환호",
          "portrait_emotion": "eager",
          "source_line": 1654
        }
      ]
    },
    {
      "id": "STORY_D21_COMBAT_02",
      "day": 21,
      "title": "DAY 21 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 10
      },
      "cues": [
        {
          "id": "STORY_D21_COMBAT_02_001",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "방패가 무거운 건 알겠는데, 왜 나한테 기대는 거야!",
          "emotion_direction": "힘씀",
          "portrait_emotion": "brave",
          "source_line": 1655
        },
        {
          "id": "STORY_D21_COMBAT_02_002",
          "speaker_id": "NARRATOR",
          "speaker_label": "방패병",
          "text_ko": "밀리지 않으려면 앞으로 기대야 하니까!",
          "emotion_direction": "당황",
          "portrait_emotion": "none",
          "source_line": 1656
        },
        {
          "id": "STORY_D21_COMBAT_02_003",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "그건 네 사정이잖아!",
          "emotion_direction": "투덜",
          "portrait_emotion": "happy",
          "source_line": 1657
        },
        {
          "id": "STORY_D21_COMBAT_02_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "푸딩, 그대로 있어. 방패 위로 각 나왔어.",
          "emotion_direction": "집중",
          "portrait_emotion": "cast",
          "source_line": 1658
        }
      ]
    },
    {
      "id": "STORY_D21_COMBAT_03",
      "day": 21,
      "title": "DAY 21 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 20
      },
      "cues": [
        {
          "id": "STORY_D21_COMBAT_03_001",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "추격과 전열을 즉석에서 분리했군요. 로만의 보고보다 반응이 빠릅니다.",
          "emotion_direction": "분석",
          "portrait_emotion": "formal",
          "source_line": 1659
        },
        {
          "id": "STORY_D21_COMBAT_03_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "보고서는 어제의 성을 적는 거야. 우리는 오늘도 바뀐다.",
          "emotion_direction": "자신",
          "portrait_emotion": "serious",
          "source_line": 1660
        },
        {
          "id": "STORY_D21_COMBAT_03_003",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "방패병, 곧 합류한다. 곱의 진입로를 막아라.",
          "emotion_direction": "지휘",
          "portrait_emotion": "formal",
          "source_line": 1661
        },
        {
          "id": "STORY_D21_COMBAT_03_004",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "어, 내 전용 문지기까지 붙었네?",
          "emotion_direction": "당황",
          "portrait_emotion": "eager",
          "source_line": 1662
        }
      ]
    },
    {
      "id": "STORY_D21_COMBAT_04",
      "day": 21,
      "title": "DAY 21 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 30
      },
      "cues": [
        {
          "id": "STORY_D21_COMBAT_04_001",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "쓰러뜨리면 특별 수당을 검토하겠습니다.",
          "emotion_direction": "원격응원",
          "portrait_emotion": "accounting",
          "source_line": 1663
        },
        {
          "id": "STORY_D21_COMBAT_04_002",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "진짜?",
          "emotion_direction": "기대",
          "portrait_emotion": "eager",
          "source_line": 1664
        },
        {
          "id": "STORY_D21_COMBAT_04_003",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "검토만 합니다.",
          "emotion_direction": "회피",
          "portrait_emotion": "accounting",
          "source_line": 1665
        },
        {
          "id": "STORY_D21_COMBAT_04_004",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "늦은 탐험가 하나가 더 합류하고, 그 뒤로 조사관이 들어옵니다.",
          "emotion_direction": "경고",
          "portrait_emotion": "stern",
          "source_line": 1666
        }
      ]
    },
    {
      "id": "STORY_D21_COMBAT_05",
      "day": 21,
      "title": "DAY 21 · 전투 대화",
      "trigger": "combat_time",
      "delivery": "combat_bark",
      "repeat_policy": "once_battle",
      "queue_policy": "append",
      "metadata": {
        "title": "전투 대화",
        "time_seconds": 40
      },
      "cues": [
        {
          "id": "STORY_D21_COMBAT_05_001",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "셀렌의 지휘가 남아 있다면 기록 회수도 빨라집니다.",
          "emotion_direction": "냉정",
          "portrait_emotion": "stern",
          "source_line": 1667
        },
        {
          "id": "STORY_D21_COMBAT_05_002",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "길게 끌지 마. 셀렌부터 끝낸다.",
          "emotion_direction": "결단",
          "portrait_emotion": "command",
          "source_line": 1668
        },
        {
          "id": "STORY_D21_COMBAT_05_003",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "곱, 길 열렸어!",
          "emotion_direction": "응원",
          "portrait_emotion": "happy",
          "source_line": 1669
        },
        {
          "id": "STORY_D21_COMBAT_05_004",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "셀렌의 오른쪽 비었어. 지금.",
          "emotion_direction": "집중",
          "portrait_emotion": "cast",
          "source_line": 1670
        }
      ]
    },
    {
