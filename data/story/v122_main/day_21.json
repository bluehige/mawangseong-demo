    {
      "id": "STORY_D21_RESULT_WIN",
      "day": 21,
      "title": "DAY 21 · 승리 결산",
      "trigger": "result_win",
      "delivery": "blocking",
      "repeat_policy": "once_battle",
      "metadata": {
        "title": "승리 결산"
      },
      "cues": [
        {
          "id": "STORY_D21_RESULT_WIN_001",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "셀렌의 지휘 표식이 꺼졌습니다. 왕국군 강화가 해제됐습니다.",
          "emotion_direction": "안도",
          "portrait_emotion": "stern",
          "source_line": 1675
        },
        {
          "id": "STORY_D21_RESULT_WIN_002",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "전군 후퇴. 오늘 기록은 충분합니다.",
          "emotion_direction": "지침",
          "portrait_emotion": "formal",
          "source_line": 1676
        },
        {
          "id": "STORY_D21_RESULT_WIN_003",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "충분하면 다음엔 안 와도 되는데.",
          "emotion_direction": "숨참",
          "portrait_emotion": "eager",
          "source_line": 1677
        },
        {
          "id": "STORY_D21_RESULT_WIN_004",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "충분히 위험하다는 기록입니다. 오히려 더 오겠죠.",
          "emotion_direction": "담담",
          "portrait_emotion": "formal",
          "source_line": 1678
        },
        {
          "id": "STORY_D21_RESULT_WIN_005",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "예전엔 네 점검표가 지겨웠는데, 오늘은 꽤 날카로웠어.",
          "emotion_direction": "인정",
          "portrait_emotion": "soft",
          "source_line": 1679
        },
        {
          "id": "STORY_D21_RESULT_WIN_006",
          "speaker_id": "CHR_SELEN",
          "speaker_label": "셀렌",
          "text_ko": "예전엔 당신의 명령이 전부 허세였지만, 오늘은 꽤 살아 있었습니다.",
          "emotion_direction": "미묘한미소",
          "portrait_emotion": "formal",
          "source_line": 1680
        },
        {
          "id": "STORY_D21_RESULT_WIN_007",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "둘이 칭찬한 거 맞지?",
          "emotion_direction": "기쁨",
          "portrait_emotion": "happy",
          "source_line": 1681
        },
        {
          "id": "STORY_D21_RESULT_WIN_008",
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "text_ko": "둘 다 칭찬을 공격처럼 하네.",
          "emotion_direction": "관찰",
          "portrait_emotion": "proud",
          "source_line": 1682
        },
        {
          "id": "STORY_D21_RESULT_WIN_009",
          "speaker_id": "CHR_GOLDIN",
          "speaker_label": "골딘",
          "text_ko": "공격으로 처리하면 방어 성공 수당에 포함해도 됩니까?",
          "emotion_direction": "계산",
          "portrait_emotion": "accounting",
          "source_line": 1683
        },
        {
          "id": "STORY_D21_RESULT_WIN_010",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "안 됩니다.",
          "emotion_direction": "무표정",
          "portrait_emotion": "stern",
          "source_line": 1684
        },
        {
          "id": "STORY_D21_RESULT_WIN_011",
          "speaker_id": "CHR_INVESTIGATOR_IRIS",
          "speaker_label": "아이리스",
          "text_ko": "북쪽 감시탑에 두 번째 봉화가 올랐습니다. 왕국 정찰대가 다음 단계로 넘어갑니다.",
          "emotion_direction": "보고",
          "portrait_emotion": "inquisitive",
          "source_line": 1685
        },
        {
          "id": "STORY_D21_RESULT_WIN_012",
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "text_ko": "다음 단계라니?",
          "emotion_direction": "경계",
          "portrait_emotion": "serious",
          "source_line": 1686
        },
        {
          "id": "STORY_D21_RESULT_WIN_013",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "오늘은 진군 속도를 시험했습니다. 내일은 우리 쪽의 교대 시간과 시설 사각을 기록하러 올 겁니다.",
          "emotion_direction": "예고",
          "portrait_emotion": "stern",
          "source_line": 1687
        },
        {
          "id": "STORY_D21_RESULT_WIN_014",
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "text_ko": "기록하라고 해. 내가 맨날 다른 길로 뛰면 되지.",
          "emotion_direction": "자신",
          "portrait_emotion": "eager",
          "source_line": 1688
        },
        {
          "id": "STORY_D21_RESULT_WIN_015",
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "text_ko": "그건 계획이 아니라 평소잖아.",
          "emotion_direction": "웃음",
          "portrait_emotion": "happy",
          "source_line": 1689
        },
        {
          "id": "STORY_D21_RESULT_WIN_016",
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "text_ko": "그리고 그 전투 기록이 쌓이면 두 번째 승급 심사가 열립니다. 내일을 막아야 다음 성장이 있습니다.",
          "emotion_direction": "마무리",
          "portrait_emotion": "stern",
          "source_line": 1690
        }
      ]
    }
  ]
