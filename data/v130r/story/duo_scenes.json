      "cues": [
        {
          "speaker_id": "CHR_TOKTOK",
          "speaker_label": "톡톡",
          "emotion_direction": "단호",
          "portrait_emotion": "determined",
          "text": "판금 달굴 자리는 비웠다. 톡.",
          "id": "V130R_DUO_LINK_MOLTEN_CARAPACE_001",
          "line": "[톡톡|단호]: 판금 달굴 자리는 비웠다. 톡."
        },
        {
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "emotion_direction": "결심",
          "portrait_emotion": "base",
          "text": "불은 내가 맡아. 네 등까지 익히는 건 아니고.",
          "id": "V130R_DUO_LINK_MOLTEN_CARAPACE_002",
          "line": "[핀|결심]: 불은 내가 맡아. 네 등까지 익히는 건 아니고."
        },
        {
          "speaker_id": "CHR_TOKTOK",
          "speaker_label": "톡톡",
          "emotion_direction": "단호",
          "portrait_emotion": "determined",
          "text": "수리 손은 조금 늦어진다. 먼저 알린다.",
          "id": "V130R_DUO_LINK_MOLTEN_CARAPACE_003",
          "line": "[톡톡|단호]: 수리 손은 조금 늦어진다. 먼저 알린다."
        },
        {
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "emotion_direction": "냉정",
          "portrait_emotion": "stern",
          "text": "공격 뒤 수리 대기까지 감당하는 연계입니다.",
          "id": "V130R_DUO_LINK_MOLTEN_CARAPACE_004",
          "line": "[바티|냉정]: 공격 뒤 수리 대기까지 감당하는 연계입니다."
        },
        {
          "speaker_id": "CHR_PYNN",
          "speaker_label": "핀",
          "emotion_direction": "미소",
          "portrait_emotion": "base",
          "text": "알았어. 멋진 불 한 번보다 돌아오는 등 하나가 중요하니까.",
          "id": "V130R_DUO_LINK_MOLTEN_CARAPACE_005",
          "line": "[핀|미소]: 알았어. 멋진 불 한 번보다 돌아오는 등 하나가 중요하니까."
        },
        {
          "speaker_id": "CHR_TOKTOK",
          "speaker_label": "톡톡",
          "emotion_direction": "흡족",
          "portrait_emotion": "happy",
          "text": "그 말이면 출발한다. 톡톡.",
          "id": "V130R_DUO_LINK_MOLTEN_CARAPACE_006",
          "line": "[톡톡|흡족]: 그 말이면 출발한다. 톡톡."
        }
      ]
