      "cues": [
        {
          "speaker_id": "CHR_DUDUM",
          "speaker_label": "두둠",
          "emotion_direction": "결심",
          "portrait_emotion": "determined",
          "text": "돌콩, 한 박자에 한 걸음 어때!",
          "id": "V130R_DUO_LINK_STONE_MARCH_001",
          "line": "[두둠|결심]: 돌콩, 한 박자에 한 걸음 어때!"
        },
        {
          "speaker_id": "CHR_DOLKONG",
          "speaker_label": "돌콩",
          "emotion_direction": "단호",
          "portrait_emotion": "determined",
          "text": "멈추는 박자도 넣어라. 콩.",
          "id": "V130R_DUO_LINK_STONE_MARCH_002",
          "line": "[돌콩|단호]: 멈추는 박자도 넣어라. 콩."
        },
        {
          "speaker_id": "CHR_DUDUM",
          "speaker_label": "두둠",
          "emotion_direction": "결심",
          "portrait_emotion": "determined",
          "text": "멈추는 것도 행진곡이지! 둥, 쉼!",
          "id": "V130R_DUO_LINK_STONE_MARCH_003",
          "line": "[두둠|결심]: 멈추는 것도 행진곡이지! 둥, 쉼!"
        },
        {
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "emotion_direction": "건조",
          "portrait_emotion": "dry",
          "text": "발동 뒤 돌콩이 움직이지 못하는 동안 옆길을 지켜 주십시오.",
          "id": "V130R_DUO_LINK_STONE_MARCH_004",
          "line": "[바티|건조]: 발동 뒤 돌콩이 움직이지 못하는 동안 옆길을 지켜 주십시오."
        },
        {
          "speaker_id": "CHR_DOLKONG",
          "speaker_label": "돌콩",
          "emotion_direction": "감동",
          "portrait_emotion": "happy",
          "text": "내가 서면 옆이 길이다. 콩.",
          "id": "V130R_DUO_LINK_STONE_MARCH_005",
          "line": "[돌콩|감동]: 내가 서면 옆이 길이다. 콩."
        },
        {
          "speaker_id": "CHR_DUDUM",
          "speaker_label": "두둠",
          "emotion_direction": "기쁨",
          "portrait_emotion": "happy",
          "text": "좋아! 네가 쉬는 박자까지 식구들이 맞출게!",
          "id": "V130R_DUO_LINK_STONE_MARCH_006",
          "line": "[두둠|기쁨]: 좋아! 네가 쉬는 박자까지 식구들이 맞출게!"
