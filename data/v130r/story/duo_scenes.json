    {
      "id": "V130R_DUO_LINK_SPORE_JELLY_SHELTER",
      "duo_id": "link_spore_jelly_shelter",
      "title": "포자 젤리 피난처",
      "member_species_ids": [
        "slime",
        "spore_healer"
      ],
      "trigger": "duo_unlock_confirmed",
      "implementation_status": "runtime_connected",
      "source_ref": "data/regular_version/update3/duo_links.json",
      "source_entry_id": "link_spore_jelly_shelter",
      "conditions": {
        "requires_owned_species_ids": [
          "slime",
          "spore_healer"
        ],
        "requires_external_unlock_event": true,
        "original_unlock_condition": {
          "bond_each": 45,
          "personal_memory_each": 1,
          "deployed_together_days": 3,
          "role_combo_count": 5,
          "event_id": "event_link_spore_jelly_shelter"
        }
      },
      "repeat_policy": "once_per_duo",
      "side_effects": [],
      "cues": [
        {
          "speaker_id": "CHR_MORI",
          "speaker_label": "모리",
          "emotion_direction": "결심",
          "portrait_emotion": "determined",
          "text": "포자 이불을 넓히려면 흔들리지 않는 자리가 필요해.",
          "id": "V130R_DUO_LINK_SPORE_JELLY_SHELTER_001",
          "line": "[모리|결심]: 포자 이불을 넓히려면 흔들리지 않는 자리가 필요해."
        },
        {
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "emotion_direction": "기쁨",
          "portrait_emotion": "base",
          "text": "푸딩 머리 위! 잠깐 멈춰 있을 수 있어!",
          "id": "V130R_DUO_LINK_SPORE_JELLY_SHELTER_002",
          "line": "[푸딩|기쁨]: 푸딩 머리 위! 잠깐 멈춰 있을 수 있어!"
        },
        {
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "emotion_direction": "냉정",
          "portrait_emotion": "stern",
          "text": "두 분이 멈추는 동안 다른 식구가 엄호합니다.",
          "id": "V130R_DUO_LINK_SPORE_JELLY_SHELTER_003",
          "line": "[바티|냉정]: 두 분이 멈추는 동안 다른 식구가 엄호합니다."
        },
        {
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "emotion_direction": "기쁨",
          "portrait_emotion": "base",
          "text": "때리는 건 나중! 지금은 덮어 주는 시간!",
          "id": "V130R_DUO_LINK_SPORE_JELLY_SHELTER_004",
          "line": "[푸딩|기쁨]: 때리는 건 나중! 지금은 덮어 주는 시간!"
        },
        {
          "speaker_id": "CHR_MORI",
          "speaker_label": "모리",
          "emotion_direction": "미소",
          "portrait_emotion": "happy",
          "text": "응. 가리는 동안 상처도 조용히 돌보자.",
          "id": "V130R_DUO_LINK_SPORE_JELLY_SHELTER_005",
          "line": "[모리|미소]: 응. 가리는 동안 상처도 조용히 돌보자."
        },
        {
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "emotion_direction": "다정",
          "portrait_emotion": "base",
          "text": "좋다. 공격 이름처럼 들리는데 식구 쉬는 자리군.",
          "id": "V130R_DUO_LINK_SPORE_JELLY_SHELTER_006",
          "line": "[마왕|다정]: 좋다. 공격 이름처럼 들리는데 식구 쉬는 자리군."
        }
      ]
    },
    {
      "id": "V130R_DUO_LINK_GHOSTLY_EVACUATE",
      "duo_id": "link_ghostly_evacuate",
      "title": "유령 이사 대작전",
      "member_species_ids": [
        "slime",
        "ghost_housemaid"
      ],
      "trigger": "duo_unlock_confirmed",
      "implementation_status": "runtime_connected",
      "source_ref": "data/regular_version/update3/duo_links.json",
      "source_entry_id": "link_ghostly_evacuate",
      "conditions": {
        "requires_owned_species_ids": [
          "slime",
          "ghost_housemaid"
        ],
        "requires_external_unlock_event": true,
        "original_unlock_condition": {
          "bond_each": 45,
          "personal_memory_each": 1,
          "deployed_together_days": 3,
          "role_combo_count": 5,
          "event_id": "memory_link_pudding_bebe"
        }
      },
      "repeat_policy": "once_per_duo",
      "side_effects": [],
      "cues": [
        {
          "speaker_id": "CHR_BEBE",
          "speaker_label": "베베",
          "emotion_direction": "단호",
          "portrait_emotion": "determined",
          "text": "다친 식구가 나갈 틈, 내가 찾을게.",
          "id": "V130R_DUO_LINK_GHOSTLY_EVACUATE_001",
          "line": "[베베|단호]: 다친 식구가 나갈 틈, 내가 찾을게."
        },
        {
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "emotion_direction": "결심",
          "portrait_emotion": "base",
          "text": "푸딩이 옆에서 가려! 조금 무거워져도 괜찮아!",
          "id": "V130R_DUO_LINK_GHOSTLY_EVACUATE_002",
          "line": "[푸딩|결심]: 푸딩이 옆에서 가려! 조금 무거워져도 괜찮아!"
        },
        {
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "emotion_direction": "냉정",
          "portrait_emotion": "stern",
          "text": "대신 받는 몫만큼 푸딩도 위험해집니다. 무한한 벽은 아닙니다.",
          "id": "V130R_DUO_LINK_GHOSTLY_EVACUATE_003",
          "line": "[바티|냉정]: 대신 받는 몫만큼 푸딩도 위험해집니다. 무한한 벽은 아닙니다."
        },
        {
          "speaker_id": "CHR_BEBE",
          "speaker_label": "베베",
          "emotion_direction": "미소",
          "portrait_emotion": "happy",
          "text": "그래서 빈자리부터 확인하는 거야.",
          "id": "V130R_DUO_LINK_GHOSTLY_EVACUATE_004",
          "line": "[베베|미소]: 그래서 빈자리부터 확인하는 거야."
        },
        {
          "speaker_id": "CHR_PUDDING",
          "speaker_label": "푸딩",
          "emotion_direction": "기쁨",
          "portrait_emotion": "base",
          "text": "푸딩 느려져도 기다려 줘! 이삿짐은 같이 와야지!",
          "id": "V130R_DUO_LINK_GHOSTLY_EVACUATE_005",
          "line": "[푸딩|기쁨]: 푸딩 느려져도 기다려 줘! 이삿짐은 같이 와야지!"
        },
        {
          "speaker_id": "CHR_DARKLORD_PLAYER",
          "speaker_label": "마왕",
          "emotion_direction": "다정",
          "portrait_emotion": "base",
          "text": "짐보다 식구를 먼저 센다. 이 성의 이사 원칙이다.",
          "id": "V130R_DUO_LINK_GHOSTLY_EVACUATE_006",
          "line": "[마왕|다정]: 짐보다 식구를 먼저 센다. 이 성의 이사 원칙이다."
        }
      ]
    },
