      "side_effects": [],
      "cues": [
        {
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "emotion_direction": "자신만만",
          "portrait_emotion": "base",
          "text": "코코, 표적 냄새 봤다? 아니, 맡았다?",
          "id": "V130R_DUO_LINK_MOON_SCENT_HUNT_001",
          "line": "[곱|자신만만]: 코코, 표적 냄새 봤다? 아니, 맡았다?"
        },
        {
          "speaker_id": "CHR_KOKO",
          "speaker_label": "코코",
          "emotion_direction": "결심",
          "portrait_emotion": "determined",
          "text": "맡았다. 돌아오는 냄새도 같이.",
          "id": "V130R_DUO_LINK_MOON_SCENT_HUNT_002",
          "line": "[코코|결심]: 맡았다. 돌아오는 냄새도 같이."
        },
        {
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "emotion_direction": "자신만만",
          "portrait_emotion": "base",
          "text": "그럼 곱은 앞으로! 주먹도 앞으로!",
          "id": "V130R_DUO_LINK_MOON_SCENT_HUNT_003",
          "line": "[곱|자신만만]: 그럼 곱은 앞으로! 주먹도 앞으로!"
        },
        {
          "speaker_id": "CHR_BATI",
          "speaker_label": "바티",
          "emotion_direction": "냉정",
          "portrait_emotion": "stern",
          "text": "추격 뒤에는 두 분 모두 더 위험합니다. 퇴로까지 확인하십시오.",
          "id": "V130R_DUO_LINK_MOON_SCENT_HUNT_004",
          "line": "[바티|냉정]: 추격 뒤에는 두 분 모두 더 위험합니다. 퇴로까지 확인하십시오."
        },
        {
          "speaker_id": "CHR_KOKO",
          "speaker_label": "코코",
          "emotion_direction": "기쁨",
          "portrait_emotion": "happy",
          "text": "곱 냄새가 멀어지면 내가 데려와.",
          "id": "V130R_DUO_LINK_MOON_SCENT_HUNT_005",
          "line": "[코코|기쁨]: 곱 냄새가 멀어지면 내가 데려와."
        },
        {
          "speaker_id": "CHR_GOB",
          "speaker_label": "곱",
          "emotion_direction": "흡족",
          "portrait_emotion": "base",
          "text": "혼자 앞서면 곱 귀 잡아! 돈은 말고!",
          "id": "V130R_DUO_LINK_MOON_SCENT_HUNT_006",
          "line": "[곱|흡족]: 혼자 앞서면 곱 귀 잡아! 돈은 말고!"
        }
      ]
    },
    {
